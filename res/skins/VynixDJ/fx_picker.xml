<!--
  Full screen Beat FX picker (Denon DJ SC Live style), shown instead of the tab
  pages while [Skin],fx_picker is set. Opened from the current effect button in
  effects.xml; loading an effect or Close hides it again. Tile N uses
  [Skin],fx_select_N and [Skin],fx_current, which refer to the Nth effect of
  VisibleEffectsList::beatFxEffectIds() (src/effects/visibleeffectslist.cpp).
-->
<Template>
  <WidgetGroup>
    <ObjectName>FxPicker</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>
      <Label>
        <ObjectName>FxPicker_Header</ObjectName>
        <Text>Select Beat FX</Text>
        <Size>0me,48f</Size>
      </Label>
      <WidgetGroup>
        <ObjectName>FxPicker_Row</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <PushButton>
            <ObjectName>FxPicker_Tile</ObjectName>
            <Size>0me,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>Echo</Text></State>
            <State><Number>1</Number><Text>Echo</Text></State>
            <Connection>
              <ConfigKey>[Skin],fx_select_1</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey>[Skin],fx_current</ConfigKey>
              <Transform><IsEqual>1</IsEqual></Transform>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxPicker_Tile</ObjectName>
            <Size>0me,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>Reverb</Text></State>
            <State><Number>1</Number><Text>Reverb</Text></State>
            <Connection>
              <ConfigKey>[Skin],fx_select_2</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey>[Skin],fx_current</ConfigKey>
              <Transform><IsEqual>2</IsEqual></Transform>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxPicker_Tile</ObjectName>
            <Size>0me,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>Flanger</Text></State>
            <State><Number>1</Number><Text>Flanger</Text></State>
            <Connection>
              <ConfigKey>[Skin],fx_select_3</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey>[Skin],fx_current</ConfigKey>
              <Transform><IsEqual>3</IsEqual></Transform>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxPicker_Tile</ObjectName>
            <Size>0me,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>Phaser</Text></State>
            <State><Number>1</Number><Text>Phaser</Text></State>
