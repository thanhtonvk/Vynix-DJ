            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxPicker_Close</ObjectName>
            <Size>0me,0me</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>Close</Text></State>
            <State><Number>1</Number><Text>Close</Text></State>
            <Connection>
              <ConfigKey>[Skin],fx_picker</ConfigKey>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey>[Skin],fx_picker</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
