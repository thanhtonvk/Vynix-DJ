<!--
  One vertical fader of the MIXER page (mixer.xml), Cross DJ style: the
  handle carries the label (VOL, LOW, MID, HI, FX). EQ and filter faders
  are neutral in the centre, the channel fader is at full volume on top.
  Variables:
    ConfigKey: fully qualified [Group],key the fader controls
    Handle: name of the handle, icons/mixer_handle_<Handle>.svg
    Width: width of the fader, e.g. 84f (EQ) or 96f (VOL)
    Reset: true to jump back to the centre when tapped twice (EQ and FX)
-->
<Template>
  <SliderComposed>
    <ObjectName>MixerFader</ObjectName>
    <Size><Variable name="Width"/>,0me</Size>
    <Slider scalemode="STRETCH">icons/mixer_groove_v.svg</Slider>
    <Handle scalemode="STRETCH_ASPECT">icons/mixer_handle_<Variable name="Handle"/>.svg</Handle>
    <Horizontal>false</Horizontal>
    <DoubleTapReset><Variable name="Reset"/></DoubleTapReset>
    <Connection>
      <ConfigKey><Variable name="ConfigKey"/></ConfigKey>
    </Connection>
  </SliderComposed>
</Template>
