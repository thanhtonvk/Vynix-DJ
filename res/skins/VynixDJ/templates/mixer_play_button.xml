<!--
  Deck PLAY / PAUSE button of the MIXER page (mixer.xml).
  The icon is set in style.qss.
  Variables:
    channel: deck number
-->
<Template>
  <PushButton>
    <ObjectName>MixerTransportPlay</ObjectName>
    <Size>68f,68f</Size>
    <NumberStates>2</NumberStates>
    <State><Number>0</Number></State>
    <State><Number>1</Number></State>
    <Connection>
      <ConfigKey>[Channel<Variable name="channel"/>],play</ConfigKey>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
  </PushButton>
</Template>
