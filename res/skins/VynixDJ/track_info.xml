<!--
  Info panel next to the track list. The selected track is loaded into
  [PreviewDeck1] by [Library],preview_selected_track (see skin.xml), so this
  panel shows its metadata and waveform overview.
-->
<Template>
  <WidgetGroup>
    <ObjectName>TrackInfoPanel</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,me</SizePolicy>
    <Size>380f,0me</Size>
    <Children>

      <Label>
        <ObjectName>TrackInfoHeader</ObjectName>
        <Text>TRACK INFO</Text>
        <Size>0me,36f</Size>
      </Label>

      <CoverArt>
        <ObjectName>TrackInfoCover</ObjectName>
        <Group>[PreviewDeck1]</Group>
        <Size>0me,180f</Size>
      </CoverArt>

      <TrackProperty>
        <ObjectName>TrackInfoTitle</ObjectName>
        <Group>[PreviewDeck1]</Group>
        <Property>title</Property>
        <Elide>right</Elide>
        <Size>0me,44f</Size>
      </TrackProperty>

      <TrackProperty>
        <ObjectName>TrackInfoArtist</ObjectName>
        <Group>[PreviewDeck1]</Group>
        <Property>artist</Property>
        <Elide>right</Elide>
        <Size>0me,32f</Size>
      </TrackProperty>

      <WidgetGroup>
        <ObjectName>TrackInfoStats</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,72f</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>TrackInfoStat</ObjectName>
            <Layout>vertical</Layout>
            <Children>
              <Label>
                <ObjectName>TrackInfoStatLabel</ObjectName>
                <Text>BPM</Text>
              </Label>
              <TrackProperty>
                <ObjectName>TrackInfoStatValue</ObjectName>
                <Group>[PreviewDeck1]</Group>
                <Property>bpmText</Property>
              </TrackProperty>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TrackInfoStat</ObjectName>
            <Layout>vertical</Layout>
            <Children>
              <Label>
                <ObjectName>TrackInfoStatLabel</ObjectName>
                <Text>KEY</Text>
              </Label>
              <TrackProperty>
                <ObjectName>TrackInfoStatValue</ObjectName>
                <Group>[PreviewDeck1]</Group>
                <Property>keyText</Property>
              </TrackProperty>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>TrackInfoStat</ObjectName>
            <Layout>vertical</Layout>
            <Children>
              <Label>
                <ObjectName>TrackInfoStatLabel</ObjectName>
                <Text>TIME</Text>
              </Label>
              <TrackProperty>
                <ObjectName>TrackInfoStatValue</ObjectName>
                <Group>[PreviewDeck1]</Group>
                <Property>durationTextSeconds</Property>
              </TrackProperty>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <TrackProperty>
        <ObjectName>TrackInfoDetail</ObjectName>
        <Group>[PreviewDeck1]</Group>
        <Property>album</Property>
        <Elide>right</Elide>
        <Size>0me,28f</Size>
      </TrackProperty>

      <TrackProperty>
        <ObjectName>TrackInfoDetail</ObjectName>
        <Group>[PreviewDeck1]</Group>
        <Property>genre</Property>
        <Elide>right</Elide>
        <Size>0me,28f</Size>
      </TrackProperty>

      <Overview>
        <ObjectName>TrackInfoOverview</ObjectName>
        <Group>[PreviewDeck1]</Group>
        <Size>0me,0me</Size>
        <BgColor>#1a1f27</BgColor>
        <SignalColor>#3d8bfd</SignalColor>
        <SignalLowColor>#3d8bfd</SignalLowColor>
        <SignalMidColor>#8cc8ff</SignalMidColor>
        <SignalHighColor>#ffffff</SignalHighColor>
        <PlayedOverlayColor>#40ffffff</PlayedOverlayColor>
        <Mark>
          <Control>cue_point</Control>
          <Color>#eb870f</Color>
        </Mark>
        <Mark>
          <Hotcue>1</Hotcue>
          <Text>A</Text>
          <Color>#f44040</Color>
          <TextColor>#f44040</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>2</Hotcue>
          <Text>B</Text>
          <Color>#0ddcf2</Color>
          <TextColor>#0ddcf2</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>3</Hotcue>
          <Text>C</Text>
          <Color>#a5df13</Color>
          <TextColor>#a5df13</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>4</Hotcue>
          <Text>D</Text>
          <Color>#ff9d00</Color>
          <TextColor>#ff9d00</TextColor>
          <Align>top</Align>
        </Mark>
      </Overview>

    </Children>
  </WidgetGroup>
</Template>
