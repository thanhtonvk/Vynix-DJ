#Mixxx {
  background-color: black;
}

/* Opaque black under the tab stacks so swapping pages never reveals the
 * cleared (white) backing store for a frame before the root repaints.
 * Pages paint on top; transparent areas now fall back to black, not white. */
#TabStack,
#SettingsStack {
  background-color: black;
}

/* Inter is not available on Android, where an unmatched family may resolve to
 * the small-caps "Carrois Gothic SC". List Roboto/Noto explicitly. */
* {
  font-family: 'Inter', 'Roboto', 'Noto Sans', sans-serif;
}

QMenuBar, QMenuBar::item, QMenu, QMenu::item {
  background-color: #a6a9ad;
}

QMenuBar::item:pressed, QMenu::item:selected, QMenu::item:pressed {
    background-color: rgba(255,255,255,0.2);
}

/************************************************************************/
/*     Buttons                                                          */
/************************************************************************/

WPushButton {
  color: #e6e7e9;
  background-color: transparent;
  border: 1px solid #2d2f31;
  border-radius: 2px;
  outline: none;
}

WPushButton:hover {
  border: 1px solid #4e5155;
}

WPushButton[value="1"] {
  color: #e6e7e9;
  border: 1px solid #4e5155;
  background-color: #2d2f31;
}

WPushButton[value="1"]:hover {
  border: 1px solid #3e4043;
  background-color: #2c2d30;
}

/************************************************************************/
/*     Deck                                                             */
/************************************************************************/

#Deck {
  border: 1px solid transparent;
  border-radius: 2px;
}

#Deck[highlight="1"] {
  border: 1px solid #e6e7e9;
}

#DeckBPMWrapper {
  border: 2px solid #e6e7e9;
  border-radius: 5px;
  margin-bottom: 4px;
  padding-right: 2px;
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#DeckBPM {
  font-size: 20px;
}

#DeckBPM[highlight="1"],
#DeckRate[highlight="1"],
#BPMPercent[highlight="1"] {
  color: #ff6a13;
}

#DeckBPMTitleWrapper {
  padding: 0 2px;
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#DeckBPMTitle {
  font-size: 8px;
  font-weight: bold;
}

#TrackBPMRangeContainer {
  padding: 5px;
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
}

#DeckBPMRangePercent {
  background-color: #111213;
  padding: 0px;
}

#BPMRangePlusMinus, #RateDisplay {
    font-size: 12px;
    font-weight: bold;
}

#DeckHeader {
  background-color: #111213;
  padding: 2px;
}

#DeckOverview {
  margin: 50% 0;
}

#DeckTitle {
  font-size: 18px;
  font-weight: bold;
}

#DeckTitlePlaying {
  font-size: 18px;
  font-weight: bold;
  color: #ff6a13;
  margin-right: 4px;
}

#DeckArtist {
  font-size: 18px;
  color: #969aa0;
}

#DeckKey {
  font-size: 13px;
  font-weight: bold;
  color: #7fccff;
  background-color: rgba(43, 166, 255, 0.1);
  margin-right: 6px;
  qproperty-alignment: 'AlignCenter';
}

/* Playing key != file key (same cue as DeckBPM for rate_ratio != 1). */
#DeckKey[highlight="1"] {
  color: #ff6a13;
  background-color: rgba(255, 106, 19, 0.12);
}

/* Matched pair with DeckKey, shown off the overview tab only. */
#DeckHeaderBPM {
  font-size: 13px;
  font-weight: bold;
  color: #7fccff;
  background-color: rgba(43, 166, 255, 0.1);
  margin-right: 6px;
  qproperty-alignment: 'AlignCenter';
}

#DeckHeaderBPM[highlight="1"] {
  color: #ff6a13;
  background-color: rgba(255, 106, 19, 0.12);
}

#DeckChannelTitle, #DeckTempoTitle,
#DeckTrackTimeRemainLabel, #DeckTrackTimeSlashLabel, #DeckTrackTimeTimeLabel {
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#DeckTrackTimeRemainLabel, #DeckTrackTimeTimeLabel {
  color: #3d3f43;
}

#DeckTrackTimeRemainLabel[highlight="1"],
#DeckTrackTimeTimeLabel[highlight="1"] {
  color: #e6e7e9;
}

#DeckTrackTimeSlashLabel {
  color: #94989e;
  padding: 0 1px;
}

#DeckHeaderTime {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#DeckHeaderTimeValue {
  font-size: 18px;
  font-weight: bold;
  qproperty-alignment: 'AlignRight | AlignVCenter';
  padding-right: 1px;
}

#DeckPlayingLeft, #DeckPlayingRight {
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#DeckTrackTimeWrapper {
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
}

#DeckTrackTime {
  font-size: 36px;
}

#DeckTrackTime[highlight="1"] {
  color: transparent;
}

#DeckTrackTimeMini {
  font-size: 20px;
}

#DeckTrackTimeMini[highlight="1"] {
  color: transparent;
}

#DeckTrackNumberContainer {
  margin: 0 4px;
  qproperty-layoutAlignment: 'AlignHCenter | AlignTop';
}

#TrackNumberWrapper, #DeckChannelTitleWrapper {
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
}

#TrackNumberTitle {
  font-size: 12px;
  text-transform: uppercase;
}

#TrackNumber {
  font-size: 20px;
  font-weight: bold;
}

/************************************************************************/
/*     BeatFX                                                           */
/************************************************************************/

#BeatFX_Container {
  padding: 8px;
  qproperty-layoutAlignment: 'AlignCenter | AlignTop';
}

#BeatFX_Header {
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
}

/* FX / KEY page tabs. Same select-only bar as the Settings sub-tabs, sized
 * down to fit the 180px panel. */
#FxPanel_TabBar {
  margin: 0 0 6px 0;
  qproperty-layoutSpacing: 4;
}

#FxPanel_TabBar WPushButton {
  background-color: transparent;
  border: 2px solid #2d2f31;
  color: #a6a9ad;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#FxPanel_TabBar WPushButton[value="1"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #e7e8e9;
}

#FxPanel_Page {
  qproperty-layoutAlignment: 'AlignTop';
}

/************************************************************************/
/*     Cue drawer                                                       */
/************************************************************************/

/* Opens the drawer on this deck; sits between the key/BPM chips and the
 * track title, so it stays narrow. */
#DeckCueChip {
  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
  color: #7fccff;
  background-color: rgba(43, 166, 255, 0.1);
  border: 1px solid transparent;
  border-radius: 2px;
  margin-right: 6px;
}

#DeckCueChip:pressed {
  color: #e7e8e9;
  background-color: #1e8fe6;
}

#CuePanel {
  background-color: #111213;
  padding: 2px;
}

#CuePanel_Header {
  qproperty-layoutSpacing: 4;
  margin-bottom: 4px;
}

#CuePanel_DeckLabel {
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  color: #a6a9ad;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* Bank toggle. Labelled with the bank on show, the same off/active
 * convention as BeatFX_ActiveToggle. */
#CuePanel_BankToggle {
  background-color: transparent;
  border: 2px solid #2d2f31;
  border-radius: 2px;
  color: #a6a9ad;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#CuePanel_BankToggle[value="1"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #e7e8e9;
}

#CuePanel_Close {
  background-color: transparent;
  border: 2px solid #2d2f31;
  border-radius: 2px;
  color: #a6a9ad;
  font-size: 15px;
  font-weight: bold;
}

#CuePanel_Close:pressed {
  border-color: #1e8fe6;
  color: #e7e8e9;
}

#CuePanel_Grid {
  qproperty-layoutSpacing: 4;
}

#CuePanel_Row {
  qproperty-layoutSpacing: 4;
}

/* Empty slot. The set and active states get their background from the cue's
 * own colour, applied by WHotcueButton as an inline stylesheet, so only the
 * text and border are set here. */
#CuePad {
  background-color: #151617;
  border: 1px solid #2d2f31;
  border-radius: 3px;
  color: #3d3f43;
  font-size: 20px;
  font-weight: bold;
}

#CuePad[displayValue="1"], #CuePad[displayValue="2"] {
  color: #e7e8e9;
  border-color: #4e5155;
}

/* WHotcueButton reports whether the cue colour is light or dark so the label
 * can stay legible against it. Exempt from daylight-mode inversion, both of
 * them: the background these are paired against is the cue's OWN colour, set
 * by WHotcueButton as an inline stylesheet and deliberately never inverted (a
 * red cue is red in both modes), and the light/dark property is computed from
 * that same un-inverted colour. Invert the label and a white saved-loop pad
 * gets white text. */
/* no-invert */
#CuePad[light="true"] {
  color: #0d0e0e;
}

/* no-invert */
#CuePad[dark="true"] {
  color: #e7e8e9;
}

/* A pad holding a saved loop rather than a plain cue point. */
#CuePad[type="loop"] {
  border: 2px solid #6ee128;
}

/* Saved loop currently running. */
#CuePad[displayValue="2"] {
  border: 2px solid #ff6a13;
}

#BeatFX_ParamRow {
  padding: 2px 0px;
}

#BeatFX_ParamLabel {
  color: #a6a9ad;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
  padding-right: 4px;
}

#BeatFX_BucketRow {
  qproperty-layoutSpacing: 2;
}

/* Beat FX tile grid (Denon DJ SC Live style) */
#BeatFX_TileGrid {
  qproperty-layoutSpacing: 4;
  margin-bottom: 4px;
}

#BeatFX_TileRow {
  qproperty-layoutSpacing: 4;
}

#BeatFX_Tile {
  color: #dadcde;
  background-color: #1e2021;
  border: 1px solid #35373a;
  border-radius: 6px;
  font-size: 12px;
  font-weight: bold;
  padding: 0px;
  text-transform: uppercase;
}

#BeatFX_Tile[displayValue="1"] {
  color: #ffffff;
  background-color: #ff6a13;
  border-color: #ff9d5c;
}

#BeatFX_CurrentEffect {
  color: #ffffff;
  background-color: #27282b;
  border: 2px solid #1e8fff;
  border-radius: 8px;
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 4px;
  text-transform: uppercase;
}

#FxPicker {
  background-color: #111213;
  padding: 8px 16px;
}

#FxPicker_Header {
  color: #93979d;
  font-size: 20px;
  font-weight: bold;
  text-transform: uppercase;
}

#FxPicker_Row {
  qproperty-layoutSpacing: 12;
  margin-bottom: 12px;
}

#FxPicker_Tile,
#FxPicker_Close {
  color: #eaeaeb;
  background-color: #1e2021;
  border: 2px solid #35373a;
  border-radius: 12px;
  font-size: 26px;
  font-weight: bold;
  text-transform: uppercase;
}

#FxPicker_Tile[displayValue="1"] {
  color: #ffffff;
  background-color: #ff6a13;
  border-color: #ff9d5c;
}

#FxPicker_Close {
  color: #93979d;
  border-style: dashed;
}

#BeatFX_BucketButton {
  color: #a6a9ad;
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 2px;
  font-size: 16px;
  font-weight: bold;
}

#BeatFX_BucketButton[displayValue="1"] {
  color: #ff6a13;
  border-color: #ff6a13;
  background-color: #2a1a13;
}

/* Parameter list below the BeatFX header. Scrolled by dragging the content
 * (ContentDragScroller), so the scroll bar is only a slim position indicator
 * and doesn't eat the narrow panel's width. */
#BeatFX_Parameters,
#BeatFX_Parameters QWidget#qt_scrollarea_viewport,
#BeatFX_ParameterList {
  background-color: transparent;
  border: 0;
}

#BeatFX_ParameterList {
  padding-top: 4px;
}

#BeatFX_Parameters QScrollBar:vertical {
  background-color: #111213;
  border: 0;
  border-radius: 2px;
  margin: 0 0 0 4px;
  width: 10px;
}

#BeatFX_Parameters QScrollBar::handle:vertical {
  background-color: #1e8fe6;
  border: 0;
  border-radius: 3px;
  min-height: 32px;
}

#BeatFX_Parameters QScrollBar::add-line:vertical,
#BeatFX_Parameters QScrollBar::sub-line:vertical {
  height: 0;
}

#BeatFX_Parameters QScrollBar::add-page:vertical,
#BeatFX_Parameters QScrollBar::sub-page:vertical {
  background: none;
}

/* Button parameters (Quantize, Triplets, ...): same surface as the buckets,
 * the current option is the text, On is highlighted like a picked bucket. */
#BeatFX_ParamButton {
  color: #a6a9ad;
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 2px;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFX_ParamButton[displayValue="1"] {
  color: #ff6a13;
  border-color: #ff6a13;
  background-color: #2a1a13;
}

/* Parameter list below the BeatFX header. Scrolled by dragging the content
 * (ContentDragScroller), so the scroll bar is only a slim position indicator
 * and doesn't eat the narrow panel's width. */
#BeatFX_Parameters,
#BeatFX_Parameters QWidget#qt_scrollarea_viewport,
#BeatFX_ParameterList {
  background-color: transparent;
  border: 0;
}

#BeatFX_ParameterList {
  padding-top: 4px;
}

#BeatFX_Parameters QScrollBar:vertical {
  background-color: #111213;
  border: 0;
  border-radius: 2px;
  margin: 0 0 0 4px;
  width: 10px;
}

#BeatFX_Parameters QScrollBar::handle:vertical {
  background-color: #1e8fe6;
  border: 0;
  border-radius: 3px;
  min-height: 32px;
}

#BeatFX_Parameters QScrollBar::add-line:vertical,
#BeatFX_Parameters QScrollBar::sub-line:vertical {
  height: 0;
}

#BeatFX_Parameters QScrollBar::add-page:vertical,
#BeatFX_Parameters QScrollBar::sub-page:vertical {
  background: none;
}

/* Button parameters (Quantize, Triplets, ...): same surface as the buckets,
 * the current option is the text, On is highlighted like a picked bucket. */
#BeatFX_ParamButton {
  color: #a6a9ad;
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 2px;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFX_ParamButton[displayValue="1"] {
  color: #c9372c;
  border-color: #c9372c;
  background-color: #2a1a13;
}

#BeatFX_ActiveToggle {
  color: #93979d;
  background-color: #1b1c1d;
  border: 2px solid #393c3f;
  border-radius: 8px;
  font-size: 20px;
  font-weight: bold;
  margin: 4px 0px;
  text-transform: uppercase;
}

#BeatFX_ActiveToggle[value="1"] {
  color: #ffffff;
  background-color: #ff6a13;
  border-color: #ff9d5c;
}

/* Deck-routing toggles for [EffectRack1_EffectUnit1]. Channel colors mirror
 * the deck badges used in the sampler view so the FX panel and the deck
 * strips agree on which color means which deck. */
#BeatFX_DeckRouting {
  qproperty-layoutSpacing: 4;
  padding: 4px 0;
}

#BeatFX_DeckAssign1,
#BeatFX_DeckAssign2 {
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 3px;
  color: #a6a9ad;
  font-size: 20px;
  font-weight: bold;
}

#BeatFX_DeckAssign1[displayValue="1"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #151617;
}

#BeatFX_DeckAssign2[displayValue="1"] {
  background-color: #ff6a13;
  border-color: #ff6a13;
  color: #151617;
}

#BeatFX_WetRow {
  qproperty-layoutAlignment: 'AlignVCenter';
  qproperty-layoutSpacing: 4;
}

#BeatFX_MixLabel {
  color: #a6a9ad;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFX_MixMeter {
  padding: 0 1px;
}

/* Both FX units stacked with [Skin],dual_fx, see beatfx_unit_compact.xml */
/* Framed like the waveform boxes next to them */
#BeatFXCompact_Unit {
  background-color: #111213;
  border: 1px solid #2a2c2e;
  border-radius: 8px;
  padding: 4px;
}

/* Same gap as between the two waveform boxes. Keep the pad of unit 2 in
 * effects.xml in sync. */
#BeatFX_UnitWrapper {
  qproperty-layoutSpacing: 24;
}

#BeatFXCompact_Row {
  qproperty-layoutSpacing: 4;
  margin-bottom: 4px;
}

#BeatFXCompact_UnitLabel {
  color: #e7e8e9;
  background-color: #2d2f31;
  border-radius: 6px;
  font-size: 15px;
  font-weight: bold;
}

#BeatFXCompact_Effect {
  color: #ffffff;
  background-color: #27282b;
  border: 2px solid #1e8fff;
  border-radius: 6px;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFXCompact_Toggle {
  color: #93979d;
  background-color: #1b1c1d;
  border: 2px solid #393c3f;
  border-radius: 6px;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFXCompact_Toggle[value="1"] {
  color: #ffffff;
  background-color: #ff6a13;
  border-color: #ff9d5c;
}

/* BEAT and LEVEL knobs, side by side under the FX On toggle */
#BeatFX_KnobRow {
  qproperty-layoutSpacing: 6;
  padding: 2px 0;
}

#BeatFX_KnobLabel {
  color: #a6a9ad;
  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
}

/* Readouts under the knobs. The beat readout is a display-only push button
 * so it can show text per division. */
#BeatFX_KnobValue,
#BeatFX_KnobNumber {
  color: #ff6a13;
  background-color: transparent;
  border: none;
  font-size: 15px;
  font-weight: bold;
}

/* KEY page: one stacked block per deck, +/-2 semitone nudges and reset. */
#KeyFX_DeckBlock {
  padding: 0 0 10px 0;
}

#KeyFX_DeckHeader {
  qproperty-layoutAlignment: 'AlignVCenter';
  qproperty-layoutSpacing: 4;
}

#KeyFX_DeckLabel_1 {
  color: #1e8fe6;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#KeyFX_DeckLabel_2 {
  color: #ff6a13;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

/* Orange whenever the playing key differs from the file's key. */
#KeyFX_DeckKey {
  color: #e7e8e9;
  font-size: 18px;
  font-weight: bold;
}

#KeyFX_DeckKey[highlight="1"] {
  color: #ff6a13;
}

#KeyFX_ButtonRow {
  qproperty-layoutSpacing: 4;
}

#KeyFX_Down,
#KeyFX_Up,
#KeyFX_Reset {
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 3px;
  color: #a6a9ad;
  font-size: 16px;
  font-weight: bold;
}

#KeyFX_Reset {
  font-size: 13px;
  text-transform: uppercase;
}

#KeyFX_Down:pressed,
#KeyFX_Up:pressed,
#KeyFX_Reset:pressed {
  border-color: #ff6a13;
  color: #ff6a13;
}

/* GRID page: the beat grid editor for one deck, picked by the 1 / 2 tabs the
 * page carries itself (templates/grid_deck_page.xml). Both deck pages use the
 * same object names, so the per-deck accent comes from the page they sit in:
 * #Grid_DeckPage_1 is blue, #Grid_DeckPage_2 orange, matching the deck colors
 * everywhere else in the skin. */
#Grid_DeckBar {
  margin: 0 0 4px 0;
  qproperty-layoutAlignment: 'AlignVCenter';
  qproperty-layoutSpacing: 4;
}

#Grid_DeckTab1,
#Grid_DeckTab2 {
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 3px;
  color: #a6a9ad;
  font-size: 18px;
  font-weight: bold;
}

#Grid_DeckTab1[displayValue="1"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #151617;
}

#Grid_DeckTab2[displayValue="1"] {
  background-color: #ff6a13;
  border-color: #ff6a13;
  color: #151617;
}

/* The grid's BPM, so it reads as the thing being edited rather than a chip. */
#Grid_Bpm {
  color: #e7e8e9;
  font-size: 20px;
  font-weight: bold;
  padding: 0 2px 0 0;
}

#Grid_ButtonRow {
  margin: 0 0 4px 0;
  qproperty-layoutSpacing: 4;
}

#Grid_Nudge,
#Grid_Align,
#Grid_Bpm_Down,
#Grid_Bpm_Up,
#Grid_Scale,
#Grid_Undo {
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 3px;
  color: #a6a9ad;
  font-size: 16px;
  font-weight: bold;
}

#Grid_Bpm_Down,
#Grid_Bpm_Up {
  font-size: 14px;
  text-transform: uppercase;
}

/* The longest word on the row and the narrowest column it can sit in, so it
 * drops a point to keep clear of its own borders. */
#Grid_Align {
  font-size: 13px;
  text-transform: uppercase;
}

/* Secondary row: a doubled/halved analysis is a rare fix, and undo is the way
 * back out of every button above it. */
#Grid_Scale,
#Grid_Undo {
  color: #6b6f76;
  font-size: 14px;
  text-transform: uppercase;
}

/* Nothing to undo — the grid is as the analyzer left it. Disabled is load
 * bearing, not decoration: a disabled WWidget never synthesizes touch ->
 * mouse, so the button stops taking taps as well as looking dead. */
#Grid_Undo:disabled {
  border-color: #222426;
  color: #383a3d;
}

/* No track on this deck, so the whole action block is off. */
#Grid_Actions:disabled,
#Grid_Nudge:disabled,
#Grid_Align:disabled,
#Grid_Bpm_Down:disabled,
#Grid_Bpm_Up:disabled,
#Grid_Scale:disabled {
  border-color: #222426;
  color: #383a3d;
}

#Grid_DeckPage_1 #Grid_Nudge:enabled:pressed,
#Grid_DeckPage_1 #Grid_Align:enabled:pressed,
#Grid_DeckPage_1 #Grid_Bpm_Down:enabled:pressed,
#Grid_DeckPage_1 #Grid_Bpm_Up:enabled:pressed,
#Grid_DeckPage_1 #Grid_Scale:enabled:pressed,
#Grid_DeckPage_1 #Grid_Undo:enabled:pressed {
  border-color: #1e8fe6;
  color: #1e8fe6;
}

#Grid_DeckPage_2 #Grid_Nudge:enabled:pressed,
#Grid_DeckPage_2 #Grid_Align:enabled:pressed,
#Grid_DeckPage_2 #Grid_Bpm_Down:enabled:pressed,
#Grid_DeckPage_2 #Grid_Bpm_Up:enabled:pressed,
#Grid_DeckPage_2 #Grid_Scale:enabled:pressed,
#Grid_DeckPage_2 #Grid_Undo:enabled:pressed {
  border-color: #ff6a13;
  color: #ff6a13;
}

/* GRID page: the beat grid editor for one deck, picked by the 1 / 2 tabs the
 * page carries itself (templates/grid_deck_page.xml). Both deck pages use the
 * same object names, so the per-deck accent comes from the page they sit in:
 * #Grid_DeckPage_1 is blue, #Grid_DeckPage_2 orange, matching the deck colors
 * everywhere else in the skin. */
#Grid_DeckBar {
  margin: 0 0 4px 0;
  qproperty-layoutAlignment: 'AlignVCenter';
  qproperty-layoutSpacing: 4;
}

#Grid_DeckTab1,
#Grid_DeckTab2 {
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 3px;
  color: #a6a9ad;
  font-size: 18px;
  font-weight: bold;
}

#Grid_DeckTab1[displayValue="1"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #151617;
}

#Grid_DeckTab2[displayValue="1"] {
  background-color: #c9372c;
  border-color: #c9372c;
  color: #151617;
}

/* The grid's BPM, so it reads as the thing being edited rather than a chip. */
#Grid_Bpm {
  color: #e7e8e9;
  font-size: 20px;
  font-weight: bold;
  padding: 0 2px 0 0;
}

#Grid_ButtonRow {
  margin: 0 0 4px 0;
  qproperty-layoutSpacing: 4;
}

#Grid_Nudge,
#Grid_Align,
#Grid_Bpm_Down,
#Grid_Bpm_Up,
#Grid_Scale,
#Grid_Undo {
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 3px;
  color: #a6a9ad;
  font-size: 16px;
  font-weight: bold;
}

#Grid_Bpm_Down,
#Grid_Bpm_Up {
  font-size: 14px;
  text-transform: uppercase;
}

/* The longest word on the row and the narrowest column it can sit in, so it
 * drops a point to keep clear of its own borders. */
#Grid_Align {
  font-size: 13px;
  text-transform: uppercase;
}

/* Secondary row: a doubled/halved analysis is a rare fix, and undo is the way
 * back out of every button above it. */
#Grid_Scale,
#Grid_Undo {
  color: #6b6f76;
  font-size: 14px;
  text-transform: uppercase;
}

/* Nothing to undo — the grid is as the analyzer left it. Disabled is load
 * bearing, not decoration: a disabled WWidget never synthesizes touch ->
 * mouse, so the button stops taking taps as well as looking dead. */
#Grid_Undo:disabled {
  border-color: #222426;
  color: #383a3d;
}

/* No track on this deck, so the whole action block is off. */
#Grid_Actions:disabled,
#Grid_Nudge:disabled,
#Grid_Align:disabled,
#Grid_Bpm_Down:disabled,
#Grid_Bpm_Up:disabled,
#Grid_Scale:disabled {
  border-color: #222426;
  color: #383a3d;
}

#Grid_DeckPage_1 #Grid_Nudge:enabled:pressed,
#Grid_DeckPage_1 #Grid_Align:enabled:pressed,
#Grid_DeckPage_1 #Grid_Bpm_Down:enabled:pressed,
#Grid_DeckPage_1 #Grid_Bpm_Up:enabled:pressed,
#Grid_DeckPage_1 #Grid_Scale:enabled:pressed,
#Grid_DeckPage_1 #Grid_Undo:enabled:pressed {
  border-color: #1e8fe6;
  color: #1e8fe6;
}

#Grid_DeckPage_2 #Grid_Nudge:enabled:pressed,
#Grid_DeckPage_2 #Grid_Align:enabled:pressed,
#Grid_DeckPage_2 #Grid_Bpm_Down:enabled:pressed,
#Grid_DeckPage_2 #Grid_Bpm_Up:enabled:pressed,
#Grid_DeckPage_2 #Grid_Scale:enabled:pressed,
#Grid_DeckPage_2 #Grid_Undo:enabled:pressed {
  border-color: #c9372c;
  color: #c9372c;
}

/************************************************************************/
/*     Effects                                                          */
/************************************************************************/

/* Opaque on purpose, unlike the transparent WPushButtons around it. Those are
 * plain QWidgets — transparent means the skin-painted parent shows through. A
 * QComboBox is a *native-styled* control: transparent leaves QStyle to paint it
 * from the widget palette, which is the platform default and the one surface
 * neither daylight-mode hook can reach, so it stayed black on a light page.
 * Declaring the surface here puts it back inside the stylesheet, which is what
 * the inversion works from. Colours are the BeatFX control surface its
 * neighbours use (BucketButton / ActiveToggle / DeckAssign). */
WEffectSelector {
  background-color: #151617;
  border: 1px solid #303134;
  border-radius: 2px;
  color: #a6a9ad;
  font-size: 14px;
  font-weight: bold;
  padding: 4px;
  text-transform: uppercase;
}
/* The drop-down button is a second palette-drawn surface: left unstyled QStyle
 * paints its raised frame from the platform palette, which is the same black
 * box the selector body was. Styling it flattens the frame — but Qt then stops
 * drawing the built-in arrow instead of falling back to it, so the arrow has to
 * come from the skin. As a QSS url() it rides the icon-inversion pipeline and
 * flips with everything else. */
WEffectSelector::drop-down {
  background-color: transparent;
  border: 0;
  subcontrol-origin: padding;
  subcontrol-position: center right;
  width: 24px;
}

WEffectSelector::down-arrow {
  image: url(skin:icons/dropdown_arrow.svg);
  width: 12px;
  height: 12px;
}

/* The open drop-down is a separate top-level popup, not a child of the closed
 * combo, so it inherits none of the above. Left unstyled it falls back to the
 * system palette — black rows that daylight mode never sees, because nothing
 * in the skin declared them. Styling it explicitly both fixes the popup and
 * puts it inside the stylesheet, which is what the inversion works from. */
WEffectSelector QAbstractItemView {
  background-color: #151617;
  border: 1px solid #2d2f31;
  color: #e6e7e9;
  selection-background-color: #1e8fe6;
  selection-color: #e7e8e9;
}

#EffectMeter {
  padding: 0px 1px 0px 1px;
}

/************************************************************************/
/*     Library                                                          */
/************************************************************************/

#LibraryWrapper QScrollBar {
  background-color: #27282b;
}

#LibraryWrapper QScrollBar::handle:horizontal {
  border: 0;
}

#LibraryWrapper QScrollBar:horizontal {
  height: 0;
  width: 0;
}

#LibraryWrapper QScrollBar:vertical {
  border: 0;
  width: 8px;
  margin: 2px;
}

#LibraryWrapper QScrollBar::handle:vertical {
  background-color: #1e8fff;
  border-radius: 4px;
  min-height: 32px;
}

#LibraryWrapper QScrollBar::add-page,
#LibraryWrapper QScrollBar::sub-page {
  background-color: #27282b;
}

#LibraryWrapper QScrollBar::add-line,
#LibraryWrapper QScrollBar::sub-line {
  height: 0;
  width: 0;
}

#LibraryWrapper WTrackTableViewHeader,
#LibraryWrapper QHeaderView {
  background-color: #333538;
}

#LibraryWrapper WTrackTableViewHeader::section,
#LibraryWrapper QHeaderView::section {
  background-color: #333538;
  color: #e5e6e8;
  font-weight: bold;
  font-size: 18px;
  padding: 10px 12px;
  border: 0;
  border-right: 1px solid #414447;
  border-bottom: 2px solid #1e8fff;
  text-transform: uppercase;
}

/* Rows for tracks already played this session render in blue.
   Cleared by Settings -> General -> Played -> Reset. Keep in sync with
   kPlayedTrackColor in browsetablemodel.cpp, which tints the Computer/USB
   file browser (a QStandardItemModel with no styleable view property). */
#LibraryWrapper WTrackTableView {
  qproperty-trackPlayedColor: #7fccff;
}

/* Track list: a lighter slate than the rest of the skin, so titles stay
   readable on a phone in a dim room. */
#LibraryWrapper QTableView,
#LibraryWrapper WLibraryTextBrowser {
  background-color: #27282b;
  alternate-background-color: #2f3133;
  selection-background-color: #1e8fff;
  color: #ffffff;
  selection-color: #ffffff;
  font-size: 24px;
  border: 0;
  gridline-color: transparent;
}

/* No vertical padding: the row height (Preferences > Library) provides the
   spacing, padding would cut off the text in short rows. */
#LibraryWrapper QTableView::item {
  padding: 0 12px;
  border: 0;
  border-bottom: 1px solid #35373a;
}

#LibraryWrapper QTableView::item:selected {
  background-color: #1e8fff;
  color: #ffffff;
}

#LibraryWrapper WLibrarySidebar {
  background-color: #27282b;
  selection-background-color: #1e8fff;
  border: 0;
  border-left: 4px solid #1e8fff;
  color: #ffffff;
  font-weight: bold;
  font-size: 22px;
  selection-color: #ffffff;
  text-transform: uppercase;
}

#LibraryWrapper WLibrarySidebar::item {
  padding: 10px 6px;
  border-bottom: 1px solid #35373a;
}

#LibraryWrapper WLibrarySidebar::item:selected {
  background-color: #1e8fff;
  color: #ffffff;
}

/* Large expand arrows and indentation, readable and easy to aim at */
#LibraryWrapper WLibrarySidebar {
  qproperty-indentation: 44;
}

#LibraryWrapper WLibrarySidebar::branch:has-children:closed {
  image: url(skin:/icons/chevron_right.svg);
}

#LibraryWrapper WLibrarySidebar::branch:has-children:open {
  image: url(skin:/icons/chevron_down.svg);
}

/* Track info panel next to the track list (track_info.xml) */
#TrackInfoPanel {
  background-color: #1e2021;
  border-left: 2px solid #1e8fff;
  padding: 10px 14px;
}

#TrackInfoHeader {
  color: #93979d;
  font-size: 16px;
  font-weight: bold;
}

#TrackInfoCover {
  background-color: #27282b;
  border-radius: 8px;
  margin: 6px 0px;
}

#TrackInfoTitle {
  color: #ffffff;
  font-size: 28px;
  font-weight: bold;
}

#TrackInfoArtist {
  color: #7fccff;
  font-size: 22px;
}

#TrackInfoStat {
  background-color: #27282b;
  border-radius: 8px;
  margin: 8px 4px;
  padding: 4px 8px;
  min-width: 96px;
}

#TrackInfoStatLabel {
  color: #93979d;
  font-size: 14px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#TrackInfoStatValue {
  color: #ffffff;
  font-size: 24px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#TrackInfoDetail {
  color: #d0d2d5;
  font-size: 18px;
}

#TrackInfoOverview {
  margin-top: 8px;
}

/* Load buttons in the deck colors of the FX routing buttons */
#TrackInfoLoadRow {
  qproperty-layoutSpacing: 8;
  margin: 4px 0;
}

#TrackInfoLoad1,
#TrackInfoLoad2 {
  color: #ffffff;
  border-radius: 8px;
  font-size: 22px;
  font-weight: bold;
  text-transform: uppercase;
}

#TrackInfoLoad1 {
  background-color: #1e8fe6;
}

#TrackInfoLoad2 {
  background-color: #ff6a13;
}

#TrackInfoLoad1[value="1"],
#TrackInfoLoad2[value="1"] {
  background-color: #2a2c2e;
}

#LibraryWrapper QPushButton,
#LibraryWrapper QSpinBox,
#LibraryWrapper QComboBox,
#LibraryWrapper QComboBox QAbstractScrollArea {
  background-color: #202223;
  color: #eaeaeb;
}

WLabel {
  color: #e6e7e9;
}

/* Library Search */
#SearchBoxContainer {
  padding: 4px;
}

#SearchBox {
  background-color: #27282b;
  border: 2px solid #3f4145;
  border-radius: 8px;
  color: #eaeaeb;
  font-size: 24px;
  padding: 2px 12px;
}

#SearchBox:focus {
  border-color: #1e8fff;
}

/* WSearchLineEdit sets the track table font on its line edit, the style
 * sheet font takes precedence */
#SearchBox QLineEdit {
  font-size: 24px;
  color: #eaeaeb;
}

/* Sidebar (hide/show) */
#SidebarContainer {
  background-color: #1e2021;
  border-bottom: 1px solid #2a2c2e;
}
#SidebarButton {
  background-color: #1e8fff;
  border: 0;
  border-radius: 8px;
  color: #ffffff;
  font-size: 22px;
  font-weight: bold;
  margin: 4px;
  text-transform: uppercase;
}
#SidebarButton:pressed {
  background-color: #0a5cb0;
}
#LibraryBreadcrumb {
  color: #93979d;
  font-size: 18px;
  font-weight: bold;
  padding-left: 12px;
}

/* Checkbox in library "Played" column */
#LibraryWrapper WTrackTableView::indicator:unchecked {
  image: url(skin:icons/library_checkbox.svg);
}
#LibraryWrapper WTrackTableView::indicator:hover {
  background-color: #1e8fe6;
}
#LibraryWrapper WTrackTableView::indicator:checked {
  image: url(skin:icons/library_checkbox_checked.svg);
}

/************************************************************************/
/*     Waveforms                                                        */
/************************************************************************/

/* Shown over the waveform while a deck has no track (waveform.xml) */
#Waveform_EmptyHint {
  color: #787c83;
  background-color: #0c0d0d;
  border: 2px dashed #27282b;
  border-radius: 12px;
  font-size: 22px;
  font-weight: bold;
  margin: 12px;
}

#WaveformInfo {
  margin-right: 10px;
}

#WaveformInfo_Header {
  background-color: #2d2f31;
  border-top-right-radius: 10px 25px;
  padding-right: 2px;
}

#WaveformInfo_Header[highlight="1"] {
  border: 2px solid #e6e7e9;
}

#WaveformInfo_Title,
#WaveformInfo_Key,
#WaveformInfo_Bars {
  color: #e6e7e9;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
}

#WaveformInfo_Data_Container,
#WaveformInfo_Key_Container,
#WaveformInfo_Bars_Container,
#WaveformInfo_Loopsize_Container {
  qproperty-layoutAlignment: 'AlignLeft | AlignTop';
}

#WaveformInfo_Key[highlight="1"] {
  color: #ff6a13;
}

#WaveformInfo_Loop_Icon {
  color: white;
  font-size: 20px;
  font-weight: bold;
  margin: 2px;
}

#WaveformInfo_BeatloopSizeSpinBox {
  margin: 3px;
  padding: -4px -4px 0px -8px;
}

WBeatSpinBox {
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
  background-color: #000000;
}

WBeatSpinBox::down-arrow,
WBeatSpinBox::up-arrow,
WBeatSpinBox::down-button,
WBeatSpinBox::up-button {
  width: 0px;
  height: 0px;
  color: #000000;
  background-color: #000000;
}

#WaveformInfo_KeylockButton {
  image: url(skin:icons/keylock.svg) no-repeat center center;
}

#WaveformInfo_QuantizeButton {
  image: url(skin:icons/quantize.svg) no-repeat center center;
}

/************************************************************************/
/*     Tabs                                                             */
/************************************************************************/

#TabControls {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1c1d1f, stop:1 #121213);
  border-bottom: 1px solid #27282b;
  margin-bottom: 2px;
}

/* Five tabs share the bar, so at the 480px floor each cell is ~96px. The
 * margin is a percentage (not px) and the font is small enough that the
 * longest label — SETTINGS, 8 chars of monospace — still clears its cell. */
#TabControls WPushButton {
  font-weight: bold;
  font-size: 16px;
  margin: 9px 3%;
  max-width: 250px;
  text-transform: uppercase;
}

#TabControls WPushButton[value="0"] {
  border: 0;
  border-radius: 12px;
  background-color: transparent;
  color: #94989e;
}

#TabControls WPushButton[value="1"] {
  border: 0;
  border-radius: 12px;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
  color: #ffffff;
}

/* Recording: next to the tabs on every page */
#TopbarRec {
  padding-right: 8px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#TabControls WPushButton#TopbarRecButton,
#TabControls WPushButton#TopbarRecButton[value="0"] {
  background-color: #1b1c1d;
  border: 2px solid #393c3f;
  border-radius: 20px;
  color: #e5352b;
  font-size: 15px;
  margin: 0;
}

#TabControls WPushButton#TopbarRecButton[displayValue="1"] {
  background-color: #d63031;
  border: 2px solid #ff6b6b;
  border-radius: 20px;
  color: #ffffff;
}

#TopbarRecTime {
  color: #ff6b6b;
  font-size: 18px;
  font-weight: bold;
}

/************************************************************************/
/*     Settings                                                         */
/************************************************************************/

#Settings {
  padding: 16px 24px;
  qproperty-layoutAlignment: 'AlignTop';
}

#SettingsRow {
  background-color: #161718;
  border-radius: 8px;
  margin-bottom: 8px;
  padding: 8px 16px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#SettingsRowLabel {
  color: #e6e7e9;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
}

/* Audio -> the Priority + Devices line. The two #SettingsRow halves share one
 * 56px line, so their bottom margin becomes a gutter between them instead. */
#AudioActionRow #SettingsRow {
  margin-bottom: 0;
  padding: 8px 10px;
}

#AudioActionRow #SettingsRow + #SettingsRow {
  margin-left: 8px;
}


/* Secondary readout sitting between a row's label and its control — the
 * resolved numbers behind a preset (Audio -> Priority). Dim and small so the
 * segment stays the thing the eye lands on. */
#SettingsRowHint {
  color: #797e85;
  font-size: 12px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
  padding-right: 10px;
}

#SettingsSegmented {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

/* General -> Track list columns: a grid of tick buttons */
#SettingsColumnSection {
  background-color: #161718;
  border-radius: 8px;
  padding: 8px 16px;
}

#SettingsColumnCheck {
  background-color: transparent;
  border: 2px solid #393b3e;
  border-radius: 6px;
  color: #a6a9ad;
  font-size: 14px;
  font-weight: bold;
  margin: 2px 4px;
  text-transform: uppercase;
}

#SettingsColumnCheck[displayValue="1"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #ffffff;
}

#SettingsSegmentLeft,
#SettingsSegmentMid,
#SettingsSegmentRight {
  background-color: transparent;
  border: 2px solid #1e8fe6;
  color: #a6a9ad;
  font-size: 14px;
  font-weight: bold;
  min-width: 80px;
  text-transform: uppercase;
}

/* Samplers MODE row carries three segments (Play/Load/Unload) plus a 2-segment
 * SOURCE row and STOP ALL on the same line — drop the min-width so the row
 * fits at the 480px floor without clipping. */
#SamplersSegmented #SettingsSegmentLeft,
#SamplersSegmented #SettingsSegmentMid,
#SamplersSegmented #SettingsSegmentRight {
  min-width: 60px;
}

/* The System page's SCREEN row carries rotation, Day/Night and Power on one
 * line so the USB drive list keeps the vertical space. At the 480px floor that
 * only clears the row width if both segment groups size to their (short)
 * labels — 0°/180° and NIGHT/DAY are at most four 14px Monospace caps, so 60px
 * still leaves them padding. */
#ScreenRotSegmented,
#ScreenModeSegmented {
  qproperty-layoutAlignment: 'AlignRight | AlignVCenter';
}

#ScreenRotSegmented #SettingsSegmentLeft,
#ScreenRotSegmented #SettingsSegmentRight,
#ScreenModeSegmented #SettingsSegmentLeft,
#ScreenModeSegmented #SettingsSegmentRight {
  min-width: 60px;
}

#SettingsSegmentLeft {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-right-width: 1px;
}

#SettingsSegmentMid {
  border-radius: 0;
  border-left-width: 1px;
  border-right-width: 1px;
}

#SettingsSegmentRight {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-left-width: 1px;
}

#SettingsSegmentLeft[displayValue="1"],
#SettingsSegmentMid[displayValue="1"],
#SettingsSegmentRight[displayValue="1"] {
  background-color: #1e8fe6;
  color: #e7e8e9;
}

#SettingsSegmentLeft[pressed="true"],
#SettingsSegmentMid[pressed="true"],
#SettingsSegmentRight[pressed="true"] {
  background-color: #0a5cb0;
  color: #e7e8e9;
}

/* A settings row can bind its `enabled` to the setting it depends on (General →
 * Brake binds [BiteDJ],vinyl_mode: only a released scratch can coast, so the
 * brake does nothing in CDJ jog mode). Qt propagates enabled down the widget
 * tree, so disabling the row lands on the label and every segment. The
 * selected segment keeps a muted fill rather than going flat, so the row still
 * says which value is stored and will apply again once the mode comes back. */
#SettingsRowLabel:disabled {
  color: #686c71;
}

#SettingsSegmentLeft:disabled,
#SettingsSegmentMid:disabled,
#SettingsSegmentRight:disabled {
  border-color: #313336;
  color: #686c71;
}

#SettingsSegmentLeft[displayValue="1"]:disabled,
#SettingsSegmentMid[displayValue="1"]:disabled,
#SettingsSegmentRight[displayValue="1"]:disabled {
  background-color: rgba(43, 166, 255, 0.18);
  color: #92969c;
}

/* Samplers → DRIVE. One chip per mounted USB drive, built at runtime by
 * WSamplerDrive: the choices are whatever is plugged in, so this is a list
 * whose length changes rather than the fixed left/mid/right strip the
 * segmented selectors below the grid are. Same fill and border as those, so
 * the selected drive reads as the same kind of choice, but each chip is
 * rounded on all four corners because it stands alone. Chips are
 * SizePolicy::Ignored and share the strip evenly, so min-width is the floor
 * that keeps four drives tappable rather than a target size. */
#SamplerDriveChip {
  background-color: transparent;
  border: 2px solid #1e8fe6;
  border-radius: 4px;
  color: #a6a9ad;
  font-size: 14px;
  font-weight: bold;
  min-width: 60px;
  padding: 0 6px;
  text-transform: uppercase;
}

#SamplerDriveChip[selected="true"] {
  background-color: #1e8fe6;
  color: #e7e8e9;
}

/* Nothing plugged in, or the drive the samples live on is not here. Muted
 * rather than styled as a chip: it is not something to tap. */
#SamplerDrivePlaceholder {
  color: #686c71;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#SettingsActionButton {
  background-color: transparent;
  border: 2px solid #1e8fe6;
  border-radius: 4px;
  color: #e7e8e9;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#SettingsActionButton[pressed="true"] {
  background-color: #0a5cb0;
}

/* The Audio Rescan button binds `enabled` to [AudioDevices],reconfigure_enabled,
 * which drops to 0 while a deck plays — rescanning re-opens the devices and
 * would cut the music. */
#SettingsActionButton:disabled {
  border-color: #313336;
  color: #686c71;
}

/* Filled accent variant for the commit action (Apply) so un-applied staged
 * settings read as a pending decision next to the outline Cancel. */
#SettingsPrimaryButton {
  background-color: #1e8fe6;
  border: 2px solid #1e8fe6;
  border-radius: 4px;
  color: #e7e8e9;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  margin-right: 6px;
}

#SettingsPrimaryButton[pressed="true"] {
  background-color: #0a5cb0;
  border-color: #0a5cb0;
}

/* Audio Apply binds `enabled` to [AudioDevices],reconfigure_enabled, which
 * drops to 0 while a deck is playing (applying re-opens the devices and would
 * cut the music). Paint it dimmed so the block reads as deliberate. */
#SettingsPrimaryButton:disabled {
  background-color: rgba(43, 166, 255, 0.12);
  border-color: #313336;
  color: #686c71;
}

#SettingsSubtabBar {
  margin: 0 0 8px 0;
}

#SettingsSubtabBar WPushButton {
  background-color: transparent;
  border: 2px solid #2d2f31;
  color: #a6a9ad;
  font-size: 14px;
  font-weight: bold;
  margin: 0 4px;
  text-transform: uppercase;
}

#SettingsSubtabBar WPushButton[value="1"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #e7e8e9;
}

#SettingsPanel {
  qproperty-layoutAlignment: 'AlignTop';
}

/* The General sub-page packs two columns of rows at the 480px floor: trim row
 * padding, label font and segment min-width so label + control fit a ~200px
 * half-column without clipping. */
#GeneralCol {
  qproperty-layoutAlignment: 'AlignTop';
  padding: 0 4px;
}

#GeneralCol #SettingsRow {
  margin-bottom: 6px;
  padding: 4px 8px;
}

#GeneralCol #SettingsRowLabel {
  font-size: 13px;
}

#GeneralCol #SettingsSegmentLeft,
#GeneralCol #SettingsSegmentMid,
#GeneralCol #SettingsSegmentRight {
  min-width: 40px;
  font-size: 12px;
}

#GeneralCol #SettingsActionButton {
  font-size: 12px;
}

#LibraryColumnsCol {
  qproperty-layoutAlignment: 'AlignTop';
  padding: 0 4px;
}

#LibraryColumnRow {
  background-color: #111213;
  border-radius: 4px;
  margin-bottom: 2px;
  padding: 2px 12px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#LibraryColumnRowLabel {
  color: #e6e7e9;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

/* The one control on a column row: OFF plus the four widths, cycled in place.
 * Outlined while the column is hidden and filled once it is showing, so the
 * page still reads as a list of on/off decisions at a glance and the width is
 * the detail you look at second. The `displayValue` property is the state
 * index (0-4), which is why this is four selectors and not `[value="1"]`. */
#LibraryColumnSizeButton,
#CharPriorityButton {
  background-color: transparent;
  border: 2px solid #313336;
  border-radius: 4px;
  color: #686c71;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
  /* The gap between the label and the button. On the button rather than the
   * label because the layout pins the button to a fixed 56f: the margin insets
   * what is painted without touching the widget's geometry, so the row's
   * minimum width does not move (the third column is already the widest and
   * gets no share of the panel's spare width) and the tap target stays the full
   * 56x40. Padding the label instead costs ~19px of column width. */
  margin-left: 8px;
}

#LibraryColumnSizeButton[displayValue="1"],
#LibraryColumnSizeButton[displayValue="2"],
#LibraryColumnSizeButton[displayValue="3"],
#LibraryColumnSizeButton[displayValue="4"],
#CharPriorityButton[displayValue="1"],
#CharPriorityButton[displayValue="2"],
#CharPriorityButton[displayValue="3"],
#CharPriorityButton[displayValue="4"] {
  background-color: #1e8fe6;
  border-color: #1e8fe6;
  color: #e7e8e9;
}

#LibraryColumnSizeButton[pressed="true"],
#CharPriorityButton[pressed="true"] {
  background-color: #0a5cb0;
  border-color: #0a5cb0;
  color: #e7e8e9;
}

/* Character priority rides at the foot of the third column and borrows the
 * column rows' chrome, one step lighter so it does not read as a fourteenth
 * library column. Its button follows the same outlined/filled rule for a
 * reason that happens to line up: AUTO is the un-overridden state. */
#CharPriorityRow {
  background-color: #1d1e1f;
  border-radius: 4px;
  margin-bottom: 2px;
  padding: 2px 12px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

/************************************************************************/
/*     Samplers                                                         */
/************************************************************************/

#SamplersHeader {
  padding: 4px 12px 8px 12px;
}

#SamplersHeaderGroup {
  margin: 0 6px;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#SamplersHeaderLabel {
  color: #a6a9ad;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
  qproperty-alignment: 'AlignRight | AlignVCenter';
  padding-right: 6px;
}

#SamplersSegmented {
  qproperty-layoutAlignment: 'AlignVCenter';
}

/* Deck-row identity badges — colored block at the start of each row so the
 * channel association is glanceable. Sampler wrappers use 0me width so the
 * 8 buttons reflow narrower at the 480f minimum to make room. */
#SamplersDeckBadge1, #SamplersDeckBadge2 {
  border-radius: 2px;
  color: #151617;
  font-size: 18px;
  font-weight: bold;
  margin: 4px 2px 4px 4px;
  qproperty-alignment: 'AlignCenter';
}

#SamplersDeckBadge1 {
  background-color: #1e8fe6;
}

#SamplersDeckBadge2 {
  background-color: #ff6a13;
}

/* PLAY-mode sampler button.
 *   loaded=0  → dim outline (empty slot, title row is empty)
 *   loaded=1  → red outline (sample loaded, idle)
 *   value=1   → solid red fill (sample playing) */
#Sampler {
  background-color: #2d2f31;
  border: 2px solid #414447;
  border-radius: 2px;
  margin: 2px 4px 4px 4px;
}

#Sampler[loaded="1"] {
  border: 2px solid #d73535;
}

#Sampler[value="1"] {
  background-color: #d73535;
  border: 2px solid #d73535;
}

#Sampler[value="1"]:hover {
  background-color: #d73535;
  border: 2px solid #d73535;
}

/* LOAD-mode button: amber palette so the user knows the next press loads. */
#SamplerLoad {
  background-color: rgba(255, 106, 19, 0.18);
  border: 2px dashed #ff6a13;
  border-radius: 2px;
  color: #ff6a13;
  font-size: 11px;
  font-weight: bold;
  margin: 2px 4px 4px 4px;
  text-transform: uppercase;
}

#SamplerLoad:hover {
  background-color: rgba(255, 106, 19, 0.28);
  border: 2px dashed #ff6a13;
}

#SamplerLoad[loaded="1"] {
  background-color: rgba(255, 106, 19, 0.30);
}

#SamplerLoad[loaded="1"]:hover {
  background-color: rgba(255, 106, 19, 0.40);
}

#SamplerLoad[pressed="true"] {
  background-color: #ff6a13;
  color: #151617;
}

/* UNLOAD-mode button: red destructive palette when a track is loaded; the
 * widget's `enabled` property is bound to track_loaded, so empty slots are
 * disabled (and dimmed) to avoid Mixxx's eject-on-empty reload-last-ejected
 * gesture. */
#SamplerUnload {
  background-color: rgba(215, 53, 53, 0.22);
  border: 2px dashed #d73535;
  border-radius: 2px;
  color: #d73535;
  font-size: 11px;
  font-weight: bold;
  margin: 2px 4px 4px 4px;
  text-transform: uppercase;
}

#SamplerUnload:hover {
  background-color: rgba(215, 53, 53, 0.32);
}

#SamplerUnload:disabled {
  background-color: rgba(215, 53, 53, 0.06);
  border: 2px dashed #5a2020;
  color: #5a2020;
}

#SamplerUnload[pressed="true"] {
  background-color: #d73535;
  color: #151617;
}

/* Track title sits directly above its sampler button. Small + elided. */
#Sampler_Info {
  color: #e6e7e9;
  font-size: 10px;
  font-weight: bold;
  padding: 0 2px;
  qproperty-alignment: 'AlignBottom | AlignHCenter';
}

/* STOP ALL — destructive palette so users register it as a panic button
 * rather than a toggle. */
#SamplersStopAll {
  background-color: transparent;
  border: 2px solid #d73535;
  border-radius: 4px;
  color: #d73535;
  font-size: 13px;
  font-weight: bold;
  margin: 0 12px;
  text-transform: uppercase;
}

#SamplersStopAll:hover {
  background-color: rgba(215, 53, 53, 0.18);
  border: 2px solid #d73535;
}

#SamplersStopAll[pressed="true"] {
  background-color: #d73535;
  color: #151617;
}

/************************************************************************/
/*     Soft-takeover indicator                                          */
/************************************************************************/

/* Overlays the topbar tabs in a stacked layout — background must stay
   opaque so the tab buttons don't bleed through. */
#SoftTakeoverStrip {
  background-color: #080909;
  border-top: 1px solid #402900;
  border-bottom: 1px solid #402900;
}

#SoftTakeoverLabel {
  color: #ff6a13;
  font-size: 16px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

/************************************************************************/
/*     Inline notification strip                                        */
/************************************************************************/

/* Overlays the topbar tabs in a stacked layout — background must stay
   opaque so the tab buttons don't bleed through. */
#NotificationStrip {
  background-color: #0b0b0c;
  border-top: 1px solid;
  border-bottom: 1px solid;
}

#NotificationStrip #NotificationLabel {
  font-size: 16px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#NotificationStrip[severity="info"],
#NotificationStrip[severity="warning"],
#NotificationStrip[severity="error"] {
  background-color: #0b0b0c;
  border-color: #593a00;
}
/* The strip's optional action (Warn's LOAD on a playing deck). Painted as a
 * filled button so it reads as the one thing to tap; the rest of the strip
 * dismisses. 44px tall in the 60px strip keeps it on the touch floor. */
#NotificationStrip #NotificationAction {
  background-color: #ff6a13;
  border-radius: 4px;
  color: #0b0b0c;
  font-size: 16px;
  font-weight: bold;
  min-height: 44px;
  min-width: 88px;
  margin-left: 8px;
  padding: 0 12px;
}

#NotificationStrip[severity="info"] #NotificationLabel,
#NotificationStrip[severity="warning"] #NotificationLabel,
#NotificationStrip[severity="error"] #NotificationLabel {
  color: #ff6a13;
}

#SettingsHeader {
  color: #a6a9ad;
  font-size: 13px;
  font-weight: bold;
  margin: 0 4px 4px 4px;
  text-transform: uppercase;
}

#SettingsVersionLabel {
  color: #4e5155;
  font-size: 11px;
}

/************************************************************************/
/*     Levels                                                           */
/************************************************************************/

/* Inside Settings > Audio, which already has the page padding */
#Levels {
  padding: 8px 0px;
}

/************************************************************************/
/*     Mixer (mixer.xml), laid out like the Cross DJ mixer              */
/************************************************************************/

/* WWidgetGroup resets the layout margins, so they are set here instead of
 * with padding: rect(left top right bottom) */
#MixerBody {
  background-color: #0b0c0d;
}

#MixerBody {
  qproperty-layoutContentsMargins: rect(8 4 8 4);
  qproperty-layoutSpacing: 6;
}

#MixerTitles,
#MixerDecks {
  qproperty-layoutSpacing: 8;
}

/* Cards */
#MixerDeckHeader,
#MixerDeck1,
#MixerDeck2,
#MixerCenter {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d1e1f, stop:1 #131415);
  border: 1px solid #27282b;
  border-radius: 14px;
}

#MixerDeckHeader {
  qproperty-layoutContentsMargins: rect(4 0 4 0);
  qproperty-layoutSpacing: 2;
}

#MixerDeckTitleRow {
  qproperty-layoutSpacing: 10;
}

#MixerDeckNumber1,
#MixerDeckNumber2 {
  color: #ffffff;
  border-radius: 10px;
  font-size: 17px;
  font-weight: bold;
}

#MixerDeckNumber1 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
}

#MixerDeckNumber2 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
}

#MixerDeckTitle {
  color: #ffffff;
  font-size: 17px;
  font-weight: bold;
}

#MixerDeckArtist,
#MixerDeckEmpty {
  color: #94989e;
  font-size: 13px;
}

#MixerDeckEmpty {
  font-size: 15px;
}

/* WKey only paints its text if the style sheet sets a background or border */
#MixerDeckKey {
  background-color: #0d0e0e;
  border-radius: 9px;
  color: #7ee787;
  font-size: 15px;
  font-weight: bold;
}

#MixerDeckBpm {
  color: #ffffff;
  font-size: 22px;
  font-weight: bold;
}

#MixerDeckUnit {
  color: #777c83;
  font-size: 10px;
  font-weight: bold;
}

#MixerDeckTime {
  color: #cacccf;
  font-size: 17px;
}

#MixerDeckOverview {
  border-radius: 6px;
}

#MixerWaveforms {
  background-color: #060607;
  border: 1px solid #1e2021;
  border-radius: 10px;
  qproperty-layoutContentsMargins: rect(6 4 6 4);
  qproperty-layoutSpacing: 2;
}

#MixerDeck1,
#MixerDeck2 {
  qproperty-layoutContentsMargins: rect(4 4 4 4);
  qproperty-layoutSpacing: 8;
}

#MixerDeckBody {
  qproperty-layoutSpacing: 5;
}

#MixerPadRow,
#MixerSideColumn {
  qproperty-layoutSpacing: 6;
}

/* Page switch: segments in one well */
#MixerModeBar {
  background-color: #0b0c0d;
  border-radius: 12px;
  qproperty-layoutContentsMargins: rect(3 3 3 3);
  qproperty-layoutSpacing: 2;
}

#MixerMode1,
#MixerMode2 {
  background-color: transparent;
  border: 0;
  border-radius: 9px;
  color: #888c92;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerMode1[value="1"] {
  background-color: rgba(43, 166, 255, 46);
  border: 0;
  color: #6cc4ff;
}

#MixerMode2[value="1"] {
  background-color: rgba(255, 133, 34, 46);
  border: 0;
  color: #ffb288;
}

/* Tempo strip */
#MixerTempo {
  qproperty-layoutSpacing: 6;
}

#MixerTempoValue {
  color: #ffffff;
  background-color: #0b0c0d;
  border-radius: 9px;
  font-size: 14px;
  font-weight: bold;
}

/* Buttons next to the turntable and pads */
#MixerTempoReset,
#MixerSide,
#MixerPad,
#MixerPadEmpty,
#MixerPadDelete,
#MixerDeckStack #CuePad[displayValue="0"],
#MixerDeckStack #MixerColorFx {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2b2d2f, stop:1 #222426);
  border: 1px solid #35373a;
  border-radius: 12px;
  color: #d0d2d5;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerTempoReset {
  border-radius: 9px;
  color: #a4a7ab;
  font-size: 13px;
}

#MixerSide {
  font-size: 12px;
  max-height: 62px;
}

#MixerDeckStack #MixerColorFx {
  font-size: 13px;
}

#MixerPad {
  font-size: 20px;
}

#MixerDeckStack #CuePad {
  border-radius: 12px;
}

#MixerDeckStack #CuePad[displayValue="0"] {
  color: #73777d;
}

#MixerPad,
#MixerPadEmpty,
#MixerPadDelete,
#MixerDeckStack #CuePad,
#MixerDeckStack #MixerColorFx {
  margin: 2px;
}

#MixerPadEmpty {
  background-color: rgba(255, 255, 255, 5);
  border: 1px dashed #393c3f;
  color: #777c83;
  font-size: 13px;
}

#MixerSide[pressed="true"],
#MixerPad[pressed="true"],
#MixerTempoReset[pressed="true"] {
  background-color: #393c3f;
}

#MixerDeck1 #MixerSide[displayValue="1"] {
  background-color: rgba(43, 166, 255, 46);
  border-color: #1f7fd0;
  color: #8fd2ff;
}

#MixerDeck2 #MixerSide[displayValue="1"] {
  background-color: rgba(255, 133, 34, 46);
  border-color: #c96a38;
  color: #ffb892;
}

#MixerDeck1 #MixerPad[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
  border-color: #7fccff;
  color: #ffffff;
}

#MixerDeck2 #MixerPad[displayValue="1"],
#MixerDeckStack #MixerColorFx[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
  border-color: #ffc59f;
  color: #ffffff;
}

#MixerPadDelete[displayValue="0"] {
  color: #46484c;
}

#MixerPadDelete[displayValue="1"],
#MixerPadDelete[displayValue="2"] {
  background-color: #6d2430;
  border-color: #d6455a;
  color: #ffffff;
}

#MixerSection {
  color: #888c92;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerBigKey {
  background-color: #0b0c0d;
  border-radius: 12px;
  color: #7ee787;
  font-size: 34px;
  font-weight: bold;
}

/* Mixer */
#MixerCenter {
  qproperty-layoutContentsMargins: rect(3 4 3 4);
  qproperty-layoutSpacing: 3;
}

#MixerKnobLabel {
  color: #94989e;
  font-size: 10px;
  font-weight: bold;
  text-transform: uppercase;
}

/* Transport */
#MixerBottomRow {
  qproperty-layoutSpacing: 8;
}

#MixerTransport1,
#MixerTransport2 {
  qproperty-layoutSpacing: 8;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#MixerTransportCue,
#MixerTransportPlay {
  background-color: qradialgradient(cx:0.5, cy:0.35, radius:0.75, fx:0.5, fy:0.25, stop:0 #343639, stop:1 #18191a);
  border: 2px solid;
  border-radius: 34px;
  font-size: 16px;
  font-weight: bold;
}

#MixerTransportCue {
  color: #ffb640;
  border-color: #7d5f2b;
  text-transform: uppercase;
}

#MixerTransportCue[displayValue="1"] {
  color: #2a1a00;
  border-color: #ffd48a;
  background-color: qradialgradient(cx:0.5, cy:0.35, radius:0.75, fx:0.5, fy:0.25, stop:0 #ffd27a, stop:1 #f59a1b);
}

#MixerTransportPlay {
  border-color: #2b7552;
  padding: 10px;
  image: url(skin:/icons/mixer_play.svg);
}

#MixerTransportPlay[value="1"] {
  border-color: #8ff0bf;
  background-color: qradialgradient(cx:0.5, cy:0.35, radius:0.75, fx:0.5, fy:0.25, stop:0 #6ff0ae, stop:1 #1fbf70);
  image: url(skin:/icons/mixer_pause.svg);
}

#MixerTransportSync,
#MixerLoopBox {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2b2d2f, stop:1 #1d1e1f);
  border: 1px solid #35373a;
  border-radius: 24px;
}

#MixerTransportSync {
  color: #d0d2d5;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerTransport1 #MixerTransportSync[value="1"],
#MixerTransport1 #MixerLoopOn {
  color: #ffffff;
  border-color: #7fccff;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
}

#MixerTransport2 #MixerTransportSync[value="1"],
#MixerTransport2 #MixerLoopOn {
  color: #ffffff;
  border-color: #ffc59f;
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
}

#MixerLoopBox {
  qproperty-layoutContentsMargins: rect(6 4 4 4);
}

#MixerLoopStep,
#MixerLoop,
#MixerLoopOn {
  background-color: transparent;
  border: 0;
  border-radius: 19px;
  color: #d0d2d5;
  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerLoopStep {
  border-radius: 16px;
  color: #94989e;
}

#MixerLoopStep[pressed="true"],
#MixerLoop[pressed="true"] {
  background-color: #393c3f;
}

#MixerLoopSize {
  background-color: transparent;
  border: 0;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 15px;
  font-weight: bold;
  qproperty-alignment: 'AlignCenter';
}

#LevelRow {
  background-color: #1a1b1d;
  border-radius: 12px;
  margin-bottom: 8px;
  padding: 8px 4px;
}

/* No qproperty-layoutAlignment here on purpose. WWidgetGroup forwards it to
 * QLayout::setAlignment, which only positions a layout inside its *parent
 * layout* — a top-level layout ignores it, so it can't centre a fixed-width
 * knob in a wider column. The columns' children are all full-width instead
 * (KnobComposed at 0me paints its knob centred via STRETCH_ASPECT). */
#LevelKnobLabel {
  color: #a6a9ad;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#LevelKnobValue {
  color: #e6e7e9;
  font-size: 12px;
}

/* Levels -> master EQ: eight band columns plus the Flat reset share the row
 * width equally so the page still fits at the 480px floor (9 x ~48px). */
#EQBandRow {
  background-color: #111213;
  border-radius: 4px;
  margin-bottom: 8px;
  padding: 8px 4px;
}

#EQBand {
  qproperty-layoutAlignment: 'AlignHCenter | AlignVCenter';
}

#EQBandLabel {
  color: #a6a9ad;
  font-size: 12px;
  font-weight: bold;
}

#EQBandValue {
  color: #e6e7e9;
  font-size: 12px;
}

/* Levels -> EQ vs Isolator. Same outline shape as the Flat button beside it,
 * because it is the same 44px column, but it names a state rather than an
 * action: the label is the mode that is live now, and ISO fills so the more
 * aggressive curve is visible from arm's length without reading the word.
 * 13px, not the 14px the action buttons use — ISO plus the borders has 44px
 * to live in. */
#EQModeButton {
  background-color: transparent;
  border: 2px solid #1e8fe6;
  border-radius: 4px;
  color: #a6a9ad;
  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
}

#EQModeButton[displayValue="1"] {
  background-color: #1e8fe6;
  color: #e7e8e9;
}

#EQModeButton[pressed="true"] {
  background-color: #0a5cb0;
  color: #e7e8e9;
}

#AudioDeviceList #AudioDeviceRow {
  background-color: #111213;
  border: 2px solid #111213;
  border-radius: 4px;
  color: #e6e7e9;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-align: left;
  text-transform: uppercase;
}

#AudioDeviceList #AudioDeviceRow[assigned="false"] {
  color: #797e85;
  border-style: dashed;
  border-color: #2d2f31;
}

#AudioDeviceList #AudioDeviceRow:pressed {
  background-color: #0a5cb0;
}

#AudioDeviceList #AudioDeviceRow[empty="true"] {
  background-color: transparent;
  border: 2px dashed #2d2f31;
  color: #4e5155;
}

#ControllerList #ControllerRow {
  background-color: #111213;
  border: 2px solid #111213;
  border-radius: 4px;
  color: #e6e7e9;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-align: left;
  text-transform: uppercase;
}

#ControllerList #ControllerRow[active="true"] {
  background-color: #0a5cb0;
  border-color: #1e8fe6;
}

#ControllerList #ControllerRow:pressed {
  background-color: #0a5cb0;
}

#ControllerList #ControllerRow[empty="true"] {
  background-color: transparent;
  border: 2px dashed #2d2f31;
  color: #4e5155;
}

/* The rows live in a scroll area so more drives / controllers than fit the
 * panel can be reached by dragging; the panel behind it has to keep showing
 * through. */
#UsbList #UsbScrollArea,
#UsbList #UsbScrollContent,
#ControllerList #ControllerScrollArea,
#ControllerList #ControllerScrollContent {
  background-color: transparent;
  border: 0;
}

/* Wide enough to grab with a fingertip, with the handle inset so it still
 * reads as a slim indicator. Track colours follow the library's scroll bar. */
#UsbList QScrollBar:vertical,
#ControllerList QScrollBar:vertical {
  background-color: #111213;
  border: 0;
  border-radius: 4px;
  margin: 0;
  width: 18px;
}

#UsbList QScrollBar::handle:vertical,
#ControllerList QScrollBar::handle:vertical {
  background-color: #1e8fe6;
  border: 0;
  border-radius: 5px;
  margin: 0 4px;
  min-height: 44px;
}

#UsbList QScrollBar::handle:vertical:pressed,
#ControllerList QScrollBar::handle:vertical:pressed {
  background-color: #7fccff;
}

#UsbList QScrollBar::add-page:vertical,
#UsbList QScrollBar::sub-page:vertical,
#ControllerList QScrollBar::add-page:vertical,
#ControllerList QScrollBar::sub-page:vertical {
  background-color: transparent;
}

#UsbList QScrollBar::add-line:vertical,
#UsbList QScrollBar::sub-line:vertical,
#ControllerList QScrollBar::add-line:vertical,
#ControllerList QScrollBar::sub-line:vertical {
  height: 0;
  width: 0;
}

/* Drive name label carries the row's appearance (there is no container widget). */
#UsbList #UsbRowLabel {
  background-color: #111213;
  border: 2px solid #111213;
  border-radius: 4px;
  color: #e6e7e9;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-transform: uppercase;
}

/* Per-row Record and Eject buttons: outlined and clearly actionable at rest,
 * filled with the highlight colour only while pressed. Both sit at min-width 96
 * rather than the 110 Eject had to itself — two buttons plus a drive name is all
 * the 400px this panel gets at the 480px floor will take, and 96 still leaves
 * EJECT and RECORD their width with room over the 44px touch floor. */
#UsbList #UsbEjectButton,
#UsbList #UsbRecordButton {
  background-color: transparent;
  border: 2px solid #1e8fe6;
  border-radius: 4px;
  color: #7fccff;
  font-size: 14px;
  font-weight: bold;
  min-height: 56px;
  min-width: 96px;
  padding: 0 14px;
  text-transform: uppercase;
}

#UsbList #UsbEjectButton:pressed,
#UsbList #UsbRecordButton:pressed {
  background-color: #0a5cb0;
  color: #e6e7e9;
}

/* Recording: filled red, the one colour that means this on any deck ever built
 * (and the LED state for a drive that must not be pulled). */
#UsbList #UsbRecordButton[recording="true"] {
  background-color: #7a2622;
  border-color: #c2453d;
  color: #e0e1e2;
}

#UsbList #UsbRecordButton[recording="true"]:pressed {
  background-color: #97302a;
  color: #ffffff;
}

/* Only one drive can be recorded to, so the others go flat for the duration —
 * paired with the disabled widget swallowing the tap rather than queueing it,
 * the same way the Audio page's Apply does while a deck is playing. */
#UsbList #UsbRecordButton:disabled {
  border-color: #2d2f31;
  color: #4e5155;
}

/* First tap arms the button; it turns danger-red to mirror the safe-to-remove
 * LED state and prompts the confirming second tap. */
#UsbList #UsbEjectButton[armed="true"] {
  background-color: #7a2622;
  border-color: #c2453d;
  color: #e0e1e2;
}

#UsbList #UsbEjectButton[armed="true"]:pressed {
  background-color: #97302a;
  color: #ffffff;
}

/* Empty-state placeholder row (a QLabel). */
#UsbList #UsbRow[empty="true"] {
  background-color: transparent;
  border: 2px dashed #2d2f31;
  border-radius: 4px;
  color: #4e5155;
  font-size: 16px;
  font-weight: bold;
  min-height: 56px;
  padding: 0 16px;
  text-transform: uppercase;
}

#SettingsDangerButton {
  background-color: transparent;
  border: 2px solid #c2453d;
  border-radius: 4px;
  color: #e7e8e9;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

#SettingsDangerButton[pressed="true"] {
  background-color: #7a2622;
}

/************************************************************************/
/*     Look of the PLAY, BROWSE and SETTINGS pages, matching the MIXER  */
/************************************************************************/

/* ---- PLAY */

#TabStack,
#SettingsStack {
  background-color: #0b0c0d;
}

#WaveformInfo {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d1e1f, stop:1 #131415);
  border: 1px solid #27282b;
  border-radius: 12px;
  margin: 4px 6px 4px 6px;
}

#WaveformInfo_Header,
#WaveformInfo_Header[highlight="1"] {
  border: 0;
  border-radius: 9px;
  margin: 4px 6px;
}

#Waveform_Channel1 #WaveformInfo_Header {
  background-color: rgba(43, 166, 255, 40);
}

#Waveform_Channel2 #WaveformInfo_Header {
  background-color: rgba(255, 133, 34, 40);
}

#Waveform_Channel1 #WaveformInfo_Header[highlight="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
}

#Waveform_Channel2 #WaveformInfo_Header[highlight="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
}

#WaveformInfo_Title {
  color: #ffffff;
  font-size: 14px;
}

#WaveformInfo_Loop_Icon {
  color: #94989e;
  font-size: 13px;
  margin: 2px 2px 2px 10px;
}

#WaveformInfo_BeatloopSizeSpinBox {
  background-color: transparent;
  margin: 0;
  padding: 0;
  font-size: 17px;
}

/* WKey only paints its text if the style sheet sets a background or border */
#WaveformInfo_Key {
  background-color: #0b0c0d;
  border-radius: 7px;
  margin: 0;
  font-size: 14px;
  color: #7ee787;
  text-transform: none;
}

#WaveformInfo_QuantizeButton,
#WaveformInfo_KeylockButton {
  background-color: #242527;
  border: 1px solid #35373a;
  border-radius: 8px;
  margin: 1px 3px;
  padding: 3px;
}

#WaveformInfo_QuantizeButton[value="1"],
#WaveformInfo_KeylockButton[value="1"] {
  background-color: rgba(43, 166, 255, 60);
  border-color: #1f7fd0;
}

#Waveform_EmptyHint {
  color: #888c92;
  background-color: #111213;
  border: 1px solid #27282b;
  border-radius: 14px;
  font-size: 19px;
  margin: 6px;
}

/* Deck strips */
#DeckHeader {
  background-color: #18191b;
  border-top: 1px solid #27282b;
}

#DeckTitle {
  color: #ffffff;
  font-size: 16px;
}

#DeckArtist {
  color: #94989e;
  font-size: 15px;
}

#DeckKey,
#DeckHeaderBPM,
#DeckCueChip {
  background-color: #0d0e0e;
  border-radius: 6px;
  color: #7ee787;
}

#DeckHeaderBPM {
  color: #ffffff;
}

#DeckCueChip {
  background-color: rgba(255, 182, 64, 40);
  border: 0;
  color: #ffb640;
}

#DeckHeaderTimeValue {
  color: #cacccf;
  font-size: 16px;
}

#DeckTitlePlaying,
#DeckPlayingLeft,
#DeckPlayingRight {
  color: #3ee08f;
}

#DeckChannelTitle,
#DeckTempoTitle,
#TrackNumberTitle,
#DeckTrackTimeRemainLabel,
#DeckTrackTimeTimeLabel {
  color: #777c83;
  font-size: 12px;
}

#DeckTrackTimeRemainLabel[highlight="1"],
#DeckTrackTimeTimeLabel[highlight="1"] {
  color: #ffffff;
}

#DeckBPMWrapper {
  background-color: #0d0e0e;
  border: 1px solid #35373a;
  border-radius: 9px;
}

#DeckBPMRangePercent {
  background-color: #1d1e1f;
  border-radius: 5px;
}

/* FX panel */
#BeatFX_Container {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d1e1f, stop:1 #131415);
  border: 1px solid #27282b;
  border-radius: 12px;
  margin: 4px;
}

#FxPanel_TabBar {
  background-color: #0b0c0d;
  border-radius: 10px;
  qproperty-layoutSpacing: 2;
}

#FxPanel_TabBar WPushButton,
#SettingsSubtabBar WPushButton {
  background-color: transparent;
  border: 0;
  border-radius: 9px;
  color: #888c92;
  font-size: 13px;
}

#FxPanel_TabBar WPushButton[value="1"],
#SettingsSubtabBar WPushButton[value="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #343639, stop:1 #27282a);
  border: 1px solid #3a3c3f;
  color: #ffffff;
}

#BeatFX_CurrentEffect,
#BeatFXCompact_Effect {
  background-color: rgba(43, 166, 255, 30);
  border: 1px solid #1f7fd0;
  border-radius: 10px;
  color: #a6dbff;
  font-size: 15px;
}

#BeatFX_DeckAssign1,
#BeatFX_DeckAssign2,
#BeatFX_ActiveToggle,
#BeatFXCompact_Toggle,
#BeatFX_BucketButton,
#BeatFX_ParamButton,
#KeyFX_Down,
#KeyFX_Up,
#KeyFX_Reset,
#Grid_DeckTab1,
#Grid_DeckTab2,
#Grid_Nudge,
#Grid_Align,
#Grid_Bpm_Down,
#Grid_Bpm_Up,
#Grid_Scale,
#Grid_Undo,
#CuePanel_BankToggle,
#CuePanel_Close {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2b2d2f, stop:1 #222426);
  border: 1px solid #35373a;
  border-radius: 9px;
  color: #d0d2d5;
}

#BeatFX_DeckAssign1,
#BeatFX_DeckAssign2,
#BeatFX_ActiveToggle,
#BeatFXCompact_Toggle {
  font-size: 15px;
}

#BeatFX_DeckAssign1[displayValue="1"],
#Grid_DeckTab1[displayValue="1"],
#CuePanel_BankToggle[value="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
  border-color: #7fccff;
  color: #ffffff;
}

#BeatFX_DeckAssign2[displayValue="1"],
#Grid_DeckTab2[displayValue="1"],
#BeatFX_ActiveToggle[value="1"],
#BeatFXCompact_Toggle[value="1"],
#BeatFX_BucketButton[displayValue="1"],
#BeatFX_ParamButton[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
  border-color: #ffc59f;
  color: #ffffff;
}

#BeatFXCompact_Unit {
  background-color: #111112;
  border: 1px solid #27282b;
  border-radius: 12px;
}

#BeatFXCompact_UnitLabel {
  background-color: #27282a;
  border-radius: 9px;
  font-size: 13px;
}

#BeatFX_KnobLabel {
  color: #94989e;
  font-size: 11px;
}

#BeatFX_KnobValue,
#BeatFX_KnobNumber {
  color: #ff9a63;
  font-size: 14px;
}

#FxPicker {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #121213, stop:1 #080809);
}

#FxPicker_Tile,
#FxPicker_Close {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2b2d2f, stop:1 #1d1e1f);
  border: 1px solid #35373a;
  border-radius: 16px;
  font-size: 22px;
}

#FxPicker_Tile[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
  border-color: #ffc59f;
}

#FxPicker_Close {
  background-color: transparent;
  border: 1px dashed #393c3f;
}

#CuePad {
  border-radius: 10px;
}

/* ---- BROWSE */

#SidebarContainer {
  background-color: #0c0d0d;
  border: 0;
}

#SearchBox {
  background-color: #18191b;
  border: 1px solid #2d2e31;
  border-radius: 14px;
  font-size: 19px;
  padding: 2px 16px;
}

#SearchBox QLineEdit {
  background-color: transparent;
  font-size: 19px;
}

#SidebarButton {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #343639, stop:1 #27282a);
  border: 1px solid #3a3c3f;
  border-radius: 14px;
  font-size: 17px;
}

#LibraryWrapper WLibrarySidebar {
  background-color: #111112;
  border: 0;
  font-size: 19px;
  selection-background-color: #0a5cb0;
}

#LibraryWrapper WLibrarySidebar::item {
  border-bottom: 1px solid #1d1e1f;
  padding: 11px 6px;
}

#LibraryWrapper WLibrarySidebar::item:selected,
#LibraryWrapper QTableView::item:selected {
  background-color: #0a5cb0;
  color: #ffffff;
}

#LibraryWrapper WTrackTableViewHeader,
#LibraryWrapper QHeaderView {
  background-color: #18191b;
}

#LibraryWrapper WTrackTableViewHeader::section,
#LibraryWrapper QHeaderView::section {
  background-color: #18191b;
  border: 0;
  border-bottom: 1px solid #2d2e31;
  color: #94989e;
  font-size: 14px;
}

#LibraryWrapper QTableView,
#LibraryWrapper WLibraryTextBrowser {
  background-color: #111112;
  alternate-background-color: #151617;
  selection-background-color: #0a5cb0;
  font-size: 21px;
}

#LibraryWrapper QTableView::item {
  border-bottom: 1px solid #1d1e1f;
}

#LibraryWrapper QScrollBar,
#LibraryWrapper QScrollBar::add-page,
#LibraryWrapper QScrollBar::sub-page {
  background-color: #111112;
}

#LibraryWrapper QScrollBar::handle:vertical {
  background-color: #3a3c3f;
  border-radius: 2px;
}

#TrackInfoPanel {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d1e1f, stop:1 #131415);
  border: 1px solid #27282b;
  border-radius: 14px;
}

#TrackInfoHeader {
  color: #777c83;
  font-size: 12px;
}

#TrackInfoCover {
  background-color: #0d0e0e;
  border-radius: 12px;
}

#TrackInfoTitle {
  font-size: 23px;
}

#TrackInfoArtist {
  color: #94989e;
  font-size: 18px;
}

#TrackInfoStat {
  background-color: #0d0e0e;
  border-radius: 12px;
}

#TrackInfoStatLabel {
  color: #777c83;
  font-size: 11px;
}

#TrackInfoStatValue {
  font-size: 19px;
}

#TrackInfoLoad1,
#TrackInfoLoad2 {
  border: 0;
  border-radius: 14px;
  font-size: 19px;
}

#TrackInfoLoad1 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
}

#TrackInfoLoad2 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
}

/* ---- SETTINGS */

#SettingsSubtabBar {
  background-color: #18191b;
  border-radius: 12px;
}

#SettingsRow,
#SettingsColumnSection,
#LibraryColumnRow {
  background-color: #18191b;
  border: 1px solid #242528;
  border-radius: 12px;
}

#SettingsRowLabel,
#SettingsHeader {
  color: #d0d2d5;
}

#SettingsSegmentLeft,
#SettingsSegmentMid,
#SettingsSegmentRight {
  background-color: #0d0e0e;
  border: 1px solid #2d2e31;
  color: #94989e;
}

#SettingsSegmentLeft {
  border-top-left-radius: 10px;
  border-bottom-left-radius: 10px;
}

#SettingsSegmentRight {
  border-top-right-radius: 10px;
  border-bottom-right-radius: 10px;
}

#SettingsSegmentLeft[displayValue="1"],
#SettingsSegmentMid[displayValue="1"],
#SettingsSegmentRight[displayValue="1"],
#SettingsPrimaryButton {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2ba6ff, stop:1 #0a78e6);
  border: 1px solid #2ba6ff;
  color: #ffffff;
}

#SettingsSegmentLeft[pressed="true"],
#SettingsSegmentMid[pressed="true"],
#SettingsSegmentRight[pressed="true"],
#SettingsActionButton[pressed="true"],
#SettingsPrimaryButton[pressed="true"] {
  background-color: #0a5cb0;
  color: #ffffff;
}

#SettingsActionButton,
#SettingsColumnCheck {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2b2d2f, stop:1 #222426);
  border: 1px solid #35373a;
  border-radius: 10px;
  color: #d0d2d5;
}

#SettingsPrimaryButton {
  border-radius: 10px;
}

#SettingsColumnCheck {
  color: #94989e;
}

#SettingsColumnCheck[displayValue="1"] {
  background-color: rgba(43, 166, 255, 46);
  border-color: #1f7fd0;
  color: #a6dbff;
}

#SettingsSegmentLeft:disabled,
#SettingsSegmentMid:disabled,
#SettingsSegmentRight:disabled,
#SettingsActionButton:disabled,
#SettingsPrimaryButton:disabled {
  background-color: #131415;
  border-color: #242528;
  color: #4a4d51;
}

#FxPanel_TabBar WPushButton[value="1"],
#SettingsSubtabBar WPushButton[value="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
  border: 0;
}

/************************************************************************/
/*     Four decks ([Skin],show_4decks)                                  */
/************************************************************************/

#CuePanel_Decks,
#LibraryDecks {
  background-color: #0b0c0d;
}

#DeckStrip {
  background-color: #1a1b1d;
  border: 1px solid #2c2d30;
  border-radius: 9px;
  margin: 1px 3px;
}

#DeckStripRow {
  qproperty-layoutSpacing: 6;
}

#DeckStripTitle {
  color: #ffffff;
  font-size: 15px;
  font-weight: bold;
}

#DeckStripKey {
  background-color: #0b0c0d;
  border-radius: 6px;
  color: #7ee787;
  font-size: 13px;
  font-weight: bold;
}

#DeckStripBpm {
  color: #ffffff;
  font-size: 15px;
  font-weight: bold;
}

#DeckStripTime {
  color: #c4c5c8;
  font-size: 14px;
}

#DeckStrip #MixerDeckNumber1,
#DeckStrip #MixerDeckNumber2,
#DeckStrip #MixerDeckNumber3,
#DeckStrip #MixerDeckNumber4 {
  border-radius: 7px;
  font-size: 14px;
}

#MixerDeckNumber3 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3fe0b0, stop:1 #0a9f78);
  border-radius: 10px;
  color: #ffffff;
  font-size: 17px;
  font-weight: bold;
}

#MixerMode3 {
  background-color: transparent;
  border: 0;
  border-radius: 9px;
  color: #808288;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerMode3[value="1"] {
  background-color: rgba(47, 214, 162, 46);
  border: 0;
  color: #7ff0cf;
}

#MixerDeck3 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #222326, stop:1 #151618);
  border: 1px solid #2c2d30;
  border-radius: 14px;
  qproperty-layoutContentsMargins: rect(4 4 4 4);
  qproperty-layoutSpacing: 8;
}

#MixerTransport3 {
  qproperty-layoutSpacing: 8;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#MixerDeck3 #MixerSide[displayValue="1"] {
  background-color: rgba(47, 214, 162, 46);
  border-color: #1a9c77;
  color: #7ff0cf;
}

#MixerDeck3 #MixerPad[displayValue="1"],
#MixerTransport3 #MixerTransportSync[value="1"],
#MixerTransport3 #MixerLoopOn,
#BeatFX_DeckAssign3[displayValue="1"],
#Grid_DeckTab3[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3fe0b0, stop:1 #0a9f78);
  border-color: #9ff5dc;
  color: #ffffff;
}

#Waveform_Channel3 #WaveformInfo_Header {
  background-color: rgba(47, 214, 162, 40);
}

#Waveform_Channel3 #WaveformInfo_Header[highlight="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3fe0b0, stop:1 #0a9f78);
}

#KeyFX_DeckLabel_3 {
  color: #7ff0cf;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#TrackInfoLoad3 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3fe0b0, stop:1 #0a9f78);
  border: 0;
  border-radius: 14px;
  color: #ffffff;
  font-size: 19px;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerDeckNumber4 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff6b7d, stop:1 #d81e3a);
  border-radius: 10px;
  color: #ffffff;
  font-size: 17px;
  font-weight: bold;
}

#MixerMode4 {
  background-color: transparent;
  border: 0;
  border-radius: 9px;
  color: #808288;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

#MixerMode4[value="1"] {
  background-color: rgba(255, 82, 104, 46);
  border: 0;
  color: #ff9fab;
}

#MixerDeck4 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #222326, stop:1 #151618);
  border: 1px solid #2c2d30;
  border-radius: 14px;
  qproperty-layoutContentsMargins: rect(4 4 4 4);
  qproperty-layoutSpacing: 8;
}

#MixerTransport4 {
  qproperty-layoutSpacing: 8;
  qproperty-layoutAlignment: 'AlignVCenter';
}

#MixerDeck4 #MixerSide[displayValue="1"] {
  background-color: rgba(255, 82, 104, 46);
  border-color: #b8344a;
  color: #ff9fab;
}

#MixerDeck4 #MixerPad[displayValue="1"],
#MixerTransport4 #MixerTransportSync[value="1"],
#MixerTransport4 #MixerLoopOn,
#BeatFX_DeckAssign4[displayValue="1"],
#Grid_DeckTab4[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff6b7d, stop:1 #d81e3a);
  border-color: #ffb3bd;
  color: #ffffff;
}

#Waveform_Channel4 #WaveformInfo_Header {
  background-color: rgba(255, 82, 104, 40);
}

#Waveform_Channel4 #WaveformInfo_Header[highlight="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff6b7d, stop:1 #d81e3a);
}

#KeyFX_DeckLabel_4 {
  color: #ff9fab;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
}

#TrackInfoLoad4 {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff6b7d, stop:1 #d81e3a);
  border: 0;
  border-radius: 14px;
  color: #ffffff;
  font-size: 19px;
  font-weight: bold;
  text-transform: uppercase;
}

#BeatFX_DeckAssign3[displayValue="0"],
#BeatFX_DeckAssign4[displayValue="0"],
#Grid_DeckTab3[displayValue="0"],
#Grid_DeckTab4[displayValue="0"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #343539, stop:1 #2a2b2e);
  border: 1px solid #3f4146;
  border-radius: 9px;
  color: #c4c5c8;
}

#BeatFX_DeckAssign3,
#BeatFX_DeckAssign4,
#Grid_DeckTab3,
#Grid_DeckTab4 {
  border-radius: 9px;
  font-size: 15px;
  font-weight: bold;
}

/* Deck switch of the MIXER page: which deck is on this side */
#MixerDeckSwitch {
  background-color: #0b0c0d;
  border-radius: 10px;
}

#MixerSwitch1,
#MixerSwitch2,
#MixerSwitch3,
#MixerSwitch4 {
  background-color: transparent;
  border: 0;
  border-radius: 9px;
  color: #808288;
  font-size: 16px;
  font-weight: bold;
}

#MixerSwitch1[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #39b1ff, stop:1 #0a78e6);
  color: #ffffff;
}

#MixerStripNumber1 {
  color: #39b1ff;
  font-size: 12px;
  font-weight: bold;
}

#MixerSwitch2[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff9d3a, stop:1 #f0590c);
  color: #ffffff;
}

#MixerStripNumber2 {
  color: #ff9d3a;
  font-size: 12px;
  font-weight: bold;
}

#MixerSwitch3[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3fe0b0, stop:1 #0a9f78);
  color: #ffffff;
}

#MixerStripNumber3 {
  color: #3fe0b0;
  font-size: 12px;
  font-weight: bold;
}

#MixerSwitch4[displayValue="1"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff6b7d, stop:1 #d81e3a);
  color: #ffffff;
}

#MixerStripNumber4 {
  color: #ff6b7d;
  font-size: 12px;
  font-weight: bold;
}

#MixerFaders {
  qproperty-layoutSpacing: 3;
}

#MixerWaveRows {
  qproperty-layoutSpacing: 2;
}

#LibraryWrapper WTrackTableViewHeader,
#LibraryWrapper QHeaderView {
  color: #9b9ca1;
  font-size: 15px;
  font-weight: bold;
}

#TrackInfoCover {
  margin: 0;
}

#MixerJogNarrow {
  qproperty-layoutSpacing: 6;
}

#MixerJogNarrow #MixerSide {
  font-size: 11px;
}

#MixerTransport1 {
  qproperty-layoutSpacing: 5;
}

#MixerTransport2 {
  qproperty-layoutSpacing: 5;
}

#MixerTransport3 {
  qproperty-layoutSpacing: 5;
}

#MixerTransport4 {
  qproperty-layoutSpacing: 5;
}

#WaveformInfo_Key_Container {
  qproperty-layoutContentsMargins: rect(6 2 2 2);
}
