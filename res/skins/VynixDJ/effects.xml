<!--
  The Overview panel to the right of the waveforms. Two pages behind an
  FX / KEY tab bar, so both control sets get the full panel instead of
  sharing it:

  FX  — single-column BeatFX for [EffectRack1_EffectUnit1_Effect1]. The
        header pins the effect picker, deck routing, mix meter, and
        Active toggle; below it a drag-scrollable list exposes every
        loaded parameter: Beats-typed bucket pickers first
        (templates/effect_param_row.xml), then button parameters such as
        Quantize and Triplets (effect_button_param_row.xml), then the
        remaining knobs (effect_knob_param_row.xml).

  KEY — one stacked block per deck (deck 1 top, deck 2 bottom) with the
        current key, +/-1 and +/-2 semitone nudges, and a reset (see
        templates/keyfx_deck_row.xml).

  GRID— the beat grid editor for one deck at a time, picked by the 1 / 2
        tabs on the page itself (see templates/grid_deck_page.xml). One
        deck at a time because the editor needs full-width buttons: two
        decks of nudge / set / BPM / scale controls do not fit this
        panel at a touchable size, and a grid is corrected for the deck
        you are cueing, not for both at once.

  With [Skin],fx_dual (Settings > General > FX) the FX page shows compact
  blocks for FX 1 and FX 2 instead (templates/fx_unit_compact.xml), for
  controllers with an FX section per side such as the Denon MC7000.

  [FxPanel],current selects the page; [FxPanel],fx / [FxPanel],key /
  [FxPanel],grid are the per-page triggers the tab buttons write, and
  [Skin],grid_deck / grid_deck1 / grid_deck2 do the same for the deck
  inside the GRID page. All are created by the skin parser. None are
  persisted — the panel opens on FX, on deck 1, every launch.
-->
<Template>
  <WidgetGroup>
    <ObjectName>BeatFX_Container</ObjectName>
    <Layout>vertical</Layout>
    <Size>180max,0me</Size>
    <Children>

      <WidgetGroup>
        <ObjectName>FxPanel_TabBar</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,36f</Size>
        <Children>
          <!-- Select-only, not toggles: always emit 1 on press (never 0),
               so tapping the already-active tab is a no-op. -->
          <PushButton>
            <ObjectName>FxPanel_TabFx</ObjectName>
            <Size>0me,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>FX</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>FX</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[FxPanel],fx</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxPanel_TabKey</ObjectName>
            <Size>0me,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>Key</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>Key</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[FxPanel],key</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxPanel_TabGrid</ObjectName>
            <Size>0me,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>Grid</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>Grid</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[FxPanel],grid</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <!--
        Ignored vertical policy on purpose. WWidgetStack forwards its
        minimumSizeHint to the *current* page, so pages of unequal height
        re-drive the Overview's vertical layout on every switch: the FX page
        (its header + a parameter row) asks for more than KEY, which stole
        ~5px off the deck strip and made the bottom of the screen jump
        between FX and KEY — and again whenever an effect with a bucket row
        was loaded. Ignored drops the stack out of the minimum-height
        calculation, so this 180px side panel is sized purely by the
        waveform column beside it. Pages are AlignTop, so content that
        outgrows the panel packs from the top instead of shoving the rest of
        the layout around.
      -->
      <WidgetStack currentpage="[FxPanel],current">
        <ObjectName>FxPanel_Stack</ObjectName>
        <SizePolicy>me,i</SizePolicy>
        <Children>

          <WidgetGroup trigger="[FxPanel],fx">
            <ObjectName>FxPanel_Page</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <!-- Single FX mode: FX 1 with its full parameter list. -->
              <WidgetGroup>
                <ObjectName>FxPanel_Single</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>

                  <WidgetGroup>
                    <ObjectName>BeatFX_Header</ObjectName>
                    <Layout>vertical</Layout>
                    <Size>0me,min</Size>
                    <Children>

                      <!-- Shows the loaded effect; tapping it opens the full screen
                           effect picker (fx_picker.xml), like the FX selection of
                           Denon DJ SC Live units. -->
                      <PushButton>
                        <ObjectName>BeatFX_CurrentEffect</ObjectName>
                        <Size>0me,44f</Size>
                        <NumberStates>12</NumberStates>
                        <State><Number>0</Number><Text>Select FX ›</Text></State>
                        <State><Number>1</Number><Text>Echo ›</Text></State>
                        <State><Number>2</Number><Text>Reverb ›</Text></State>
                        <State><Number>3</Number><Text>Flanger ›</Text></State>
                        <State><Number>4</Number><Text>Phaser ›</Text></State>
                        <State><Number>5</Number><Text>Filter ›</Text></State>
                        <State><Number>6</Number><Text>Trans ›</Text></State>
                        <State><Number>7</Number><Text>Pan ›</Text></State>
                        <State><Number>8</Number><Text>Glitch ›</Text></State>
                        <State><Number>9</Number><Text>Pitch ›</Text></State>
                        <State><Number>10</Number><Text>Crush ›</Text></State>
                        <State><Number>11</Number><Text>Noise ›</Text></State>
                        <Connection>
                          <ConfigKey>[Skin],fx_picker_open</ConfigKey>
                          <ButtonState>LeftButton</ButtonState>
                          <ConnectValueToWidget>false</ConnectValueToWidget>
                        </Connection>
                        <Connection>
                          <ConfigKey>[Skin],fx_current</ConfigKey>
                          <ConnectValueFromWidget>false</ConnectValueFromWidget>
                        </Connection>
                      </PushButton>

                      <WidgetGroup>
                        <ObjectName>BeatFX_DeckRouting</ObjectName>
                        <Layout>horizontal</Layout>
                        <Size>0me,40f</Size>
                        <Children>
                          <PushButton>
                            <ObjectName>BeatFX_DeckAssign1</ObjectName>
                            <Size>0me,40f</Size>
                            <NumberStates>2</NumberStates>
                            <State>
                              <Number>0</Number>
                              <Text>Deck 1</Text>
                            </State>
                            <State>
                              <Number>1</Number>
                              <Text>Deck 1</Text>
                            </State>
                            <Connection>
                              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                              <ConnectValueToWidget>true</ConnectValueToWidget>
                            </Connection>
                          </PushButton>
                          <PushButton>
                            <ObjectName>BeatFX_DeckAssign2</ObjectName>
                            <Size>0me,40f</Size>
                            <NumberStates>2</NumberStates>
                            <State>
                              <Number>0</Number>
                              <Text>Deck 2</Text>
                            </State>
                            <State>
                              <Number>1</Number>
                              <Text>Deck 2</Text>
                            </State>
                            <Connection>
                              <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                              <ConnectValueToWidget>true</ConnectValueToWidget>
                            </Connection>
                          </PushButton>
                        </Children>
                      </WidgetGroup>

                      <!-- The effect's on/off switch gets its own full-width row: next
                           to the deck buttons it read as a third routing choice. -->
                      <PushButton>
                        <ObjectName>BeatFX_ActiveToggle</ObjectName>
                        <Size>0me,48f</Size>
                        <NumberStates>2</NumberStates>
                        <State>
                          <Number>0</Number>
                          <Text>FX Off</Text>
                        </State>
                        <State>
                          <Number>1</Number>
                          <Text>FX On</Text>
                        </State>
                        <Connection>
                          <ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey>
                        </Connection>
                      </PushButton>


                      <!-- Depth of the loaded effect: its metaknob, which drives
                           the parameters the effect links to it (flanger depth,
                           filter cutoff, white noise amount, ...). Controllers
                           move the same control with their Beat FX level knob. -->
                      <WidgetGroup>
                        <ObjectName>BeatFX_WetRow</ObjectName>
                        <Layout>vertical</Layout>
                        <Size>0me,76f</Size>
                        <Children>
                          <Label>
                            <ObjectName>BeatFX_MixLabel</ObjectName>
                            <Text>Level/Depth</Text>
                            <Size>0me,26f</Size>
                          </Label>
                          <SliderComposed>
                            <ObjectName>BeatFX_MixSlider</ObjectName>
                            <Size>0me,40f</Size>
                            <Slider scalemode="STRETCH">icons/mix_slider_groove.svg</Slider>
                            <Handle scalemode="STRETCH_ASPECT">icons/mix_slider_handle.svg</Handle>
                            <Horizontal>true</Horizontal>
                            <Connection>
                              <ConfigKey>[EffectRack1_EffectUnit1_Effect1],meta</ConfigKey>
                            </Connection>
                          </SliderComposed>
                        </Children>
                      </WidgetGroup>

                    </Children>
                  </WidgetGroup>

                  <!--
                    Parameter list, drag-scrollable (ContentDragScroller) so an
                    effect can expose all of its parameters below the pinned
                    header. Mixxx allocates kDefaultMaxParameters (16) knob and
                    16 button parameter slots per effect; every row collapses
                    when its slot isn't loaded, so the list packs from the top.
                    Order: Beats-typed buckets first (what the controller's Beat
                    buttons step), then button parameters (Quantize / Triplets
                    modify the beat division right above them), then the
                    remaining knobs.

                    The rows address slots by index only, so a controller with
                    finer parameter controls can drive the same parameterN /
                    button_parameterN / parameterN_beat_period controls and the
                    list follows.
                  -->
                  <Scrollable>
                    <ObjectName>BeatFX_Parameters</ObjectName>
                    <!-- Expanding, not MinimumExpanding: the list's full height
                         must never be the floor, or the page would outgrow the
                         panel instead of scrolling. -->
                    <SizePolicy>e,e</SizePolicy>
                    <WidgetResizable>true</WidgetResizable>
                    <ScrollToTopOn>[EffectRack1_EffectUnit1_Effect1],loaded_effect</ScrollToTopOn>
                    <HorizontalScrollBarPolicy>off</HorizontalScrollBarPolicy>
                    <Children>
                      <WidgetGroup>
                        <ObjectName>BeatFX_ParameterList</ObjectName>
                        <Layout>vertical</Layout>
                        <SizePolicy>me,min</SizePolicy>
                        <Children>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">1</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">2</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">3</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">4</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">5</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">6</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">7</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">8</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">9</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">10</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">11</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">12</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">13</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">14</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">15</SetVariable>
                          </Template>
                          <Template src="skin:templates/effect_param_row.xml">
                            <SetVariable name="rack">1</SetVariable>
                            <SetVariable name="unit">1</SetVariable>
                            <SetVariable name="effect">1</SetVariable>
                            <SetVariable name="param">16</SetVariable>
                          </Template>
                          <WidgetGroup>
                            <ObjectName>BeatFX_Spacer</ObjectName>
                            <Size>0me,0me</Size>
                          </WidgetGroup>
                        </Children>
                      </WidgetGroup>
                    </Children>
                    <Connection>
                      <ConfigKey>[EffectRack1_EffectUnit1_Effect1],loaded</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </Scrollable>

                </Children>
                <Connection>
                  <ConfigKey>[Skin],fx_dual</ConfigKey>
                  <Transform><Not/></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>

              <!-- Dual FX mode ([Skin],fx_dual, Settings > General): compact
                   blocks for FX 1 and FX 2, e.g. the left and right FX
                   sections of a controller. Drag-scrollable in case the
                   panel is not tall enough for both. -->
              <Scrollable>
                <ObjectName>BeatFX_Parameters</ObjectName>
                <SizePolicy>e,e</SizePolicy>
                <WidgetResizable>true</WidgetResizable>
                <HorizontalScrollBarPolicy>off</HorizontalScrollBarPolicy>
                <Children>
                  <WidgetGroup>
                    <ObjectName>BeatFX_ParameterList</ObjectName>
                    <Layout>vertical</Layout>
                    <SizePolicy>me,min</SizePolicy>
                    <Children>
                      <Template src="skin:templates/fx_unit_compact.xml">
                        <SetVariable name="unit">1</SetVariable>
                        <SetVariable name="current_key">fx_current</SetVariable>
                        <SetVariable name="open_key">fx_picker_open</SetVariable>
                      </Template>
                      <Template src="skin:templates/fx_unit_compact.xml">
                        <SetVariable name="unit">2</SetVariable>
                        <SetVariable name="current_key">fx_current2</SetVariable>
                        <SetVariable name="open_key">fx_picker_open2</SetVariable>
                      </Template>
                      <WidgetGroup>
                        <ObjectName>BeatFX_Spacer</ObjectName>
                        <Size>0me,0me</Size>
                      </WidgetGroup>
                    </Children>
                  </WidgetGroup>
                </Children>
                <Connection>
                  <ConfigKey>[Skin],fx_dual</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Scrollable>

            </Children>
          </WidgetGroup>

          <!--
            KEY page: one block per deck, stacked. No shared "selected deck"
            state exists in this skin, so each block targets its own
            [ChannelN] controls.
          -->
          <WidgetGroup trigger="[FxPanel],key">
            <ObjectName>FxPanel_Page</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <Template src="skin:templates/keyfx_deck_row.xml">
                <SetVariable name="channel">1</SetVariable>
              </Template>
              <Template src="skin:templates/keyfx_deck_row.xml">
                <SetVariable name="channel">2</SetVariable>
              </Template>

              <WidgetGroup>
                <ObjectName>BeatFX_Spacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          <!--
            GRID — beat grid editor. One page per deck behind the 1 / 2 tabs
            the pages carry themselves, so the deck bar reads as one strip
            while the stack swaps under it. Both pages are the same size, so
            switching decks does not resize the panel.
          -->
          <WidgetGroup trigger="[FxPanel],grid">
            <ObjectName>FxPanel_Page</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <WidgetStack currentpage="[Skin],grid_deck">
                <ObjectName>Grid_DeckStack</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <WidgetGroup trigger="[Skin],grid_deck1">
                    <Layout>vertical</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Template src="skin:templates/grid_deck_page.xml">
                        <SetVariable name="channel">1</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup trigger="[Skin],grid_deck2">
                    <Layout>vertical</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <Template src="skin:templates/grid_deck_page.xml">
                        <SetVariable name="channel">2</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetStack>

              <WidgetGroup>
                <ObjectName>BeatFX_Spacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

        </Children>
      </WidgetStack>

    </Children>
  </WidgetGroup>
</Template>
