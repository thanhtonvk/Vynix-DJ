<Template>
  <WidgetGroup>
    <ObjectName>Settings</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>SettingsSubtabBar</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,40f</Size>
        <Children>
          <Template src="skin:templates/setting_subtab_button.xml">
            <SetVariable name="Text">General</SetVariable>
            <SetVariable name="ConfigKey">general</SetVariable>
          </Template>
          <Template src="skin:templates/setting_subtab_button.xml">
            <SetVariable name="Text">Library</SetVariable>
            <SetVariable name="ConfigKey">columns</SetVariable>
          </Template>
          <Template src="skin:templates/setting_subtab_button.xml">
            <SetVariable name="Text">Device</SetVariable>
            <SetVariable name="ConfigKey">midi</SetVariable>
          </Template>
          <Template src="skin:templates/setting_subtab_button.xml">
            <SetVariable name="Text">Audio</SetVariable>
            <SetVariable name="ConfigKey">audio</SetVariable>
          </Template>
          <Template src="skin:templates/setting_subtab_button.xml">
            <SetVariable name="Text">System</SetVariable>
            <SetVariable name="ConfigKey">system</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
      <WidgetStack currentpage="[SettingsTab],current" persist="true">
        <ObjectName>SettingsStack</ObjectName>
        <Children>
          <WidgetGroup trigger="[SettingsTab],general">
            <ObjectName>SettingsPanel</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <ObjectName>GeneralCol</ObjectName>
                    <Layout>vertical</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <WidgetGroup>
                        <ObjectName>SettingsRow</ObjectName>
                        <Layout>horizontal</Layout>
                        <Size>0me,52f</Size>
                        <Children>
                          <Label>
                            <ObjectName>SettingsRowLabel</ObjectName>
                            <Text>Key</Text>
                            <Size>0me,0me</Size>
                          </Label>
                          <WidgetGroup>
                            <ObjectName>SettingsSegmented</ObjectName>
                            <Layout>horizontal</Layout>
                            <Size>160f,40f</Size>
                            <Children>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentLeft</SetVariable>
                                <SetVariable name="Text">Camelot</SetVariable>
                                <SetVariable name="ConfigKey">[Library],key_notation</SetVariable>
                                <SetVariable name="Value">3</SetVariable>
                              </Template>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentRight</SetVariable>
                                <SetVariable name="Text">Trad</SetVariable>
                                <SetVariable name="ConfigKey">[Library],key_notation</SetVariable>
                                <SetVariable name="Value">4</SetVariable>
                              </Template>
                            </Children>
                          </WidgetGroup>
                        </Children>
                      </WidgetGroup>
                      <WidgetGroup>
                        <ObjectName>SettingsRow</ObjectName>
                        <Layout>horizontal</Layout>
                        <Size>0me,52f</Size>
                        <Children>
                          <Label>
                            <ObjectName>SettingsRowLabel</ObjectName>
                            <Text>Xfader</Text>
                            <Size>0me,0me</Size>
                          </Label>
                          <PushButton>
                            <ObjectName>SettingsActionButton</ObjectName>
                            <Size>64f,40f</Size>
                            <NumberStates>3</NumberStates>
                            <State>
                              <Number>0</Number>
                              <Text>1: A</Text>
                            </State>
                            <State>
                              <Number>1</Number>
                              <Text>1: Thru</Text>
                            </State>
                            <State>
                              <Number>2</Number>
                              <Text>1: B</Text>
                            </State>
                            <Connection>
                              <ConfigKey>[Channel1],orientation</ConfigKey>
                              <EmitOnDownPress>true</EmitOnDownPress>
                              <ButtonState>LeftButton</ButtonState>
                            </Connection>
                          </PushButton>
                          <WidgetGroup>
                            <Size>8f,0me</Size>
                          </WidgetGroup>
                          <PushButton>
                            <ObjectName>SettingsActionButton</ObjectName>
                            <Size>64f,40f</Size>
                            <NumberStates>3</NumberStates>
                            <State>
                              <Number>0</Number>
                              <Text>2: A</Text>
                            </State>
                            <State>
                              <Number>1</Number>
                              <Text>2: Thru</Text>
                            </State>
                            <State>
                              <Number>2</Number>
                              <Text>2: B</Text>
                            </State>
                            <Connection>
                              <ConfigKey>[Channel2],orientation</ConfigKey>
                              <EmitOnDownPress>true</EmitOnDownPress>
                              <ButtonState>LeftButton</ButtonState>
                            </Connection>
                          </PushButton>
                        </Children>
                      </WidgetGroup>
                      <WidgetGroup>
                        <ObjectName>SettingsRow</ObjectName>
                        <Layout>horizontal</Layout>
                        <Size>0me,52f</Size>
                        <Children>
                          <Label>
                            <ObjectName>SettingsRowLabel</ObjectName>
                            <Text>Load Gate</Text>
                            <Size>0me,0me</Size>
                          </Label>
                          <WidgetGroup>
                            <ObjectName>SettingsSegmented</ObjectName>
                            <Layout>horizontal</Layout>
                            <Size>150f,40f</Size>
                            <Children>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentLeft</SetVariable>
                                <SetVariable name="Text">Allow</SetVariable>
                                <SetVariable name="ConfigKey">[Controls],load_when_deck_playing</SetVariable>
                                <SetVariable name="Value">1</SetVariable>
                              </Template>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentMid</SetVariable>
                                <SetVariable name="Text">Stop</SetVariable>
                                <SetVariable name="ConfigKey">[Controls],load_when_deck_playing</SetVariable>
                                <SetVariable name="Value">2</SetVariable>
                              </Template>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentRight</SetVariable>
                                <SetVariable name="Text">Block</SetVariable>
                                <SetVariable name="ConfigKey">[Controls],load_when_deck_playing</SetVariable>
                                <SetVariable name="Value">0</SetVariable>
                              </Template>
                            </Children>
                          </WidgetGroup>
                        </Children>
                      </WidgetGroup>
                      <WidgetGroup>
                        <ObjectName>SettingsSpacer</ObjectName>
                        <Size>0me,0me</Size>
                      </WidgetGroup>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>GeneralCol</ObjectName>
                    <Layout>vertical</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>
                      <WidgetGroup>
                        <ObjectName>SettingsRow</ObjectName>
                        <Layout>horizontal</Layout>
                        <Size>0me,52f</Size>
                        <Children>
                          <Label>
                            <ObjectName>SettingsRowLabel</ObjectName>
                            <Text>Wave</Text>
                            <Size>0me,0me</Size>
                          </Label>
                          <WidgetGroup>
                            <ObjectName>SettingsSegmented</ObjectName>
                            <Layout>horizontal</Layout>
                            <Size>150f,40f</Size>
                            <Children>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentLeft</SetVariable>
                                <SetVariable name="Text">RGB</SetVariable>
                                <SetVariable name="ConfigKey">[Waveform],waveform_type</SetVariable>
                                <SetVariable name="Value">12</SetVariable>
                              </Template>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentMid</SetVariable>
                                <SetVariable name="Text">Filt</SetVariable>
                                <SetVariable name="ConfigKey">[Waveform],waveform_type</SetVariable>
                                <SetVariable name="Value">7</SetVariable>
                              </Template>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentRight</SetVariable>
                                <SetVariable name="Text">HSV</SetVariable>
                                <SetVariable name="ConfigKey">[Waveform],waveform_type</SetVariable>
                                <SetVariable name="Value">8</SetVariable>
                              </Template>
                            </Children>
                          </WidgetGroup>
                        </Children>
                      </WidgetGroup>
                      <!-- One Beat FX unit like DDJ controllers, or one per
                           side like Denon DJ and Numark controllers -->
                      <WidgetGroup>
                        <ObjectName>SettingsRow</ObjectName>
                        <Layout>horizontal</Layout>
                        <Size>0me,52f</Size>
                        <Children>
                          <Label>
                            <ObjectName>SettingsRowLabel</ObjectName>
                            <Text>FX units</Text>
                            <Size>0me,0me</Size>
                          </Label>
                          <WidgetGroup>
                            <ObjectName>SettingsSegmented</ObjectName>
                            <Layout>horizontal</Layout>
                            <Size>150f,40f</Size>
                            <Children>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentLeft</SetVariable>
                                <SetVariable name="Text">1 FX</SetVariable>
                                <SetVariable name="ConfigKey">[Skin],dual_fx</SetVariable>
                                <SetVariable name="Value">0</SetVariable>
                              </Template>
                              <Template src="skin:templates/setting_segment_button.xml">
                                <SetVariable name="ObjectName">SettingsSegmentRight</SetVariable>
                                <SetVariable name="Text">2 FX</SetVariable>
                                <SetVariable name="ConfigKey">[Skin],dual_fx</SetVariable>
                                <SetVariable name="Value">1</SetVariable>
                              </Template>
                            </Children>
                          </WidgetGroup>
                        </Children>
                      </WidgetGroup>
                      <WidgetGroup>
                        <ObjectName>SettingsSpacer</ObjectName>
                        <Size>0me,0me</Size>
                      </WidgetGroup>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SettingsColumnSection</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>me,min</SizePolicy>
                <Children>
                  <Label>
                    <ObjectName>SettingsRowLabel</ObjectName>
                    <Text>Track list columns</Text>
                    <Size>0me,32f</Size>
                  </Label>
                  <WidgetGroup>
                    <ObjectName>SettingsColumnChecks</ObjectName>
                    <Layout>horizontal</Layout>
                    <Size>0me,48f</Size>
                    <Children>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">cover</SetVariable>
                        <SetVariable name="Text">Cover</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">artist</SetVariable>
                        <SetVariable name="Text">Artist</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">title</SetVariable>
                        <SetVariable name="Text">Title</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">album</SetVariable>
                        <SetVariable name="Text">Album</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">genre</SetVariable>
                        <SetVariable name="Text">Genre</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">year</SetVariable>
                        <SetVariable name="Text">Year</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup>
                    <ObjectName>SettingsColumnChecks</ObjectName>
                    <Layout>horizontal</Layout>
                    <Size>0me,48f</Size>
                    <Children>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">key</SetVariable>
                        <SetVariable name="Text">Key</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">bpm</SetVariable>
                        <SetVariable name="Text">BPM</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">duration</SetVariable>
                        <SetVariable name="Text">Time</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">rating</SetVariable>
                        <SetVariable name="Text">Rating</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">comment</SetVariable>
                        <SetVariable name="Text">Comment</SetVariable>
                      </Template>
                      <Template src="skin:templates/setting_column_check.xml">
                        <SetVariable name="Column">date_added</SetVariable>
                        <SetVariable name="Text">Added</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SettingsSpacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup trigger="[SettingsTab],midi">
            <ObjectName>SettingsPanel</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>SettingsRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,64f</Size>
                <Children>
                  <Label>
                    <ObjectName>SettingsRowLabel</ObjectName>
                    <Text>DJ controllers</Text>
                    <Size>0me,0me</Size>
                  </Label>
                  <Label>
                    <ObjectName>SettingsRowHint</ObjectName>
                    <Text>Enable a controller and choose its mapping</Text>
                    <Size>0me,0me</Size>
                  </Label>
                  <PushButton>
                    <ObjectName>SettingsActionButton</ObjectName>
                    <Size>180f,48f</Size>
                    <NumberStates>1</NumberStates>
                    <State>
                      <Number>0</Number>
                      <Text>Open</Text>
                    </State>
                    <Connection>
                      <ConfigKey>[Skin],show_preferences_controllers</ConfigKey>
                      <EmitOnDownPress>true</EmitOnDownPress>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SettingsSpacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup trigger="[SettingsTab],columns">
            <ObjectName>SettingsPanel</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>SettingsRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,64f</Size>
                <Children>
                  <Label>
                    <ObjectName>SettingsRowLabel</ObjectName>
                    <Text>Music library</Text>
                    <Size>0me,0me</Size>
                  </Label>
                  <Label>
                    <ObjectName>SettingsRowHint</ObjectName>
                    <Text>Folders, rescan and library options</Text>
                    <Size>0me,0me</Size>
                  </Label>
                  <PushButton>
                    <ObjectName>SettingsActionButton</ObjectName>
                    <Size>180f,48f</Size>
                    <NumberStates>1</NumberStates>
                    <State>
                      <Number>0</Number>
                      <Text>Open</Text>
                    </State>
                    <Connection>
                      <ConfigKey>[Skin],show_preferences_library</ConfigKey>
                      <EmitOnDownPress>true</EmitOnDownPress>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SettingsSpacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup trigger="[SettingsTab],system">
            <ObjectName>SettingsPanel</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>SettingsRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,52f</Size>
                <Children>
                  <Label>
                    <ObjectName>SettingsRowLabel</ObjectName>
                    <Text>Preferences</Text>
                    <Size>0me,0me</Size>
                  </Label>
                  <PushButton>
                    <ObjectName>SettingsActionButton</ObjectName>
                    <Size>140f,40f</Size>
                    <NumberStates>1</NumberStates>
                    <State>
                      <Number>0</Number>
                      <Text>Open</Text>
                    </State>
                    <Connection>
                      <ConfigKey>[Skin],show_preferences</ConfigKey>
                      <EmitOnDownPress>true</EmitOnDownPress>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SettingsSpacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup trigger="[SettingsTab],audio">
            <ObjectName>SettingsPanel</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>SettingsRow</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,64f</Size>
                <Children>
                  <Label>
                    <ObjectName>SettingsRowLabel</ObjectName>
                    <Text>Sound output</Text>
                    <Size>0me,0me</Size>
                  </Label>
                  <Label>
                    <ObjectName>SettingsRowHint</ObjectName>
                    <Text>Output device, latency and sample rate</Text>
                    <Size>0me,0me</Size>
                  </Label>
                  <PushButton>
                    <ObjectName>SettingsActionButton</ObjectName>
                    <Size>180f,48f</Size>
                    <NumberStates>1</NumberStates>
                    <State>
                      <Number>0</Number>
                      <Text>Open</Text>
                    </State>
                    <Connection>
                      <ConfigKey>[Skin],show_preferences_sound</ConfigKey>
                      <EmitOnDownPress>true</EmitOnDownPress>
                    </Connection>
                  </PushButton>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>SettingsSpacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetStack>
      <WidgetGroup>
        <ObjectName>Decks</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,80max</Size>
        <Children>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">1</SetVariable>
          </Template>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">2</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>